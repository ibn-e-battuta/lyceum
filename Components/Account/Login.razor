@page "/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@inject UserService Users
@inject NavigationManager Nav
@inject OidcOptions Oidc

<PageTitle>@L["Sign in"] · CourseHub</PageTitle>

<main class="auth">
    <div class="auth-card">
        <div class="auth-brand"><span class="logo">▶</span> CourseHub</div>
        <h1>@L["Sign in"]</h1>
        @if (Changed) { <p class="good tiny">@L["Password changed. Sign in with your new password."]</p> }
        @if (!string.IsNullOrEmpty(ErrorMessage)) { <p class="error tiny">@ErrorMessage</p> }
        @if (Oidc.Enabled)
        {
            <a class="btn primary wide sso-btn" href="@($"/auth/oidc/login?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}")">@L["Sign in with {0}", Oidc.DisplayName]</a>
            @if (!Oidc.DisablePasswordLogin) { <div class="divider">@L["or"]</div> }
        }
        @if (!Oidc.Enabled || !Oidc.DisablePasswordLogin)
        {
        <EditForm Model="Input" method="post" OnValidSubmit="SignInAsync" FormName="login">
            <DataAnnotationsValidator />
            <label class="field"><span>@L["Username"]</span><InputText @bind-Value="Input!.Username" autocomplete="username" autofocus /></label>
            <label class="field"><span>@L["Password"]</span><InputText type="password" @bind-Value="Input!.Password" autocomplete="current-password" /></label>
            <label class="toggle"><InputCheckbox @bind-Value="Input!.Remember" /> @L["Keep me signed in"]</label>
            @if (error is not null) { <p class="error tiny">@error</p> }
            <ValidationSummary class="error tiny" />
            <button class="btn @(Oidc.Enabled ? "ghost" : "primary") wide" type="submit">@L["Sign in"]</button>
        </EditForm>
        }
    </div>
</main>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private LoginInput? Input { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "changed")] private string? ChangedFlag { get; set; }
    [SupplyParameterFromQuery(Name = "error")] private string? ErrorMessage { get; set; }
    private bool Changed => ChangedFlag == "1";
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        if (await Users.CountAsync() == 0) Nav.NavigateTo("/setup");
        else if (HttpMethods.IsGet(HttpContext.Request.Method) && HttpContext.User.Identity?.IsAuthenticated == true) Nav.NavigateTo(SafeReturnUrl);
    }

    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\") ? ReturnUrl : "/";

    private async Task SignInAsync()
    {
        var key = $"{HttpContext.Connection.RemoteIpAddress}|{Input!.Username.Trim().ToLowerInvariant()}";
        if (Users.IsLockedOut(key))
        {
            error = L["Too many attempts. Try again in 15 minutes."];
            Input!.Password = "";
            return;
        }
        var user = await Users.VerifyAsync(Input!.Username, Input!.Password, key);
        if (user is null)
        {
            error = L["Wrong username or password."];
            Input.Password = "";
            return;
        }
        await HttpContext.SignInAsync(UserService.Principal(user), new AuthenticationProperties
        {
            IsPersistent = Input!.Remember,
            ExpiresUtc = Input!.Remember ? DateTimeOffset.UtcNow.AddDays(60) : null,
        });
        Nav.NavigateTo(SafeReturnUrl, forceLoad: true);
    }

    private sealed class LoginInput
    {
        [Required] public string Username { get; set; } = "";
        [Required] public string Password { get; set; } = "";
        public bool Remember { get; set; } = true;
    }
}
