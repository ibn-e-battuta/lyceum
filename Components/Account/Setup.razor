@page "/setup"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@inject UserService Users
@inject CourseLibrary Library
@inject NavigationManager Nav

<PageTitle>Welcome · CourseHub</PageTitle>

<main class="auth">
    <div class="auth-card">
        <div class="auth-brand"><span class="logo">▶</span> CourseHub</div>
        <h1>Welcome!</h1>
        <p class="muted">Create the admin account. You can add more people later in Settings.</p>
        <p class="muted tiny">Found @Library.Courses.Count courses in <code>@Library.RootPath</code>.</p>
        <EditForm Model="Input" method="post" OnValidSubmit="CreateAsync" FormName="setup">
            <DataAnnotationsValidator />
            <label class="field"><span>Username</span><InputText @bind-Value="Input!.Username" autocomplete="username" autofocus /></label>
            <label class="field"><span>Password (8+ characters)</span><InputText type="password" @bind-Value="Input!.Password" autocomplete="new-password" /></label>
            <label class="field"><span>Repeat password</span><InputText type="password" @bind-Value="Input!.Confirm" autocomplete="new-password" /></label>
            @if (error is not null) { <p class="error tiny">@error</p> }
            <ValidationSummary class="error tiny" />
            <button class="btn primary wide" type="submit">Create admin account</button>
        </EditForm>
    </div>
</main>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private SetupInput? Input { get; set; }
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        // Setup is only open until the first account exists.
        if (await Users.CountAsync() > 0) Nav.NavigateTo("/login");
    }

    private async Task CreateAsync()
    {
        if (Input!.Password != Input!.Confirm)
        {
            error = "The passwords don't match.";
            Input.Password = Input.Confirm = "";
            return;
        }
        var (user, err) = await Users.CreateAsync(Input!.Username, Input!.Password, isAdmin: true);
        if (user is null)
        {
            error = err;
            return;
        }
        await HttpContext.SignInAsync(UserService.Principal(user), new AuthenticationProperties { IsPersistent = true });
        Nav.NavigateTo("/", forceLoad: true);
    }

    private sealed class SetupInput
    {
        [Required] public string Username { get; set; } = "";
        [Required] public string Password { get; set; } = "";
        [Required] public string Confirm { get; set; } = "";
    }
}
