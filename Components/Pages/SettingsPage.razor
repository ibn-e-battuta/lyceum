@page "/settings"
@using System.Net.NetworkInformation
@using System.Net.Sockets
@inherits AppPage
@implements IDisposable
@inject CourseLibrary Library
@inject MediaTools Tools
@inject TranscriptService Transcripts
@inject Transcoder Transcoder
@inject UserDataService UserData
@inject UserService Users
@inject ApiKeyService ApiKeys
@inject AppSettingsService AppSettings
@inject AiService Ai
@inject NotificationService Notifications
@inject OidcOptions Oidc
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject TotpService Totp
@inject GuestService Guests
@inject BackupService Backups
@inject ReminderService Reminders
@inject IConfiguration Config

<PageTitle>@L["Settings"] · Lyceum</PageTitle>

<TopNav />

<main class="home narrow settings">
    <h1 class="page-title">@L["Settings"]</h1>
    <nav class="settings-nav">
        <a href="settings#account">@L["Account"]</a>
        <a href="settings#api">@L["API keys"]</a>
        @if (IsAdmin)
        {
            <a href="settings#users">@L["Users"]</a>
            <a href="settings#libraries">@L["Libraries"]</a>
            <a href="settings#playback">@L["Playback"]</a>
            <a href="settings#transcripts">@L["Transcripts"]</a>
            <a href="settings#ai">AI</a>
            <a href="settings#notifications">@L["Notifications"]</a>
        }
        <a href="settings#security">@L["Security"]</a>
        <a href="settings#goals">@L["Goals"]</a>
        <a href="settings#backup">@L["Backup"]</a>
        @if (IsAdmin) { <a href="settings#guests">@L["Guest links"]</a> <a href="settings#server-backups">@L["Server backups"]</a> }
    </nav>

    <section class="panel" id="account">
        <h2>@L["Account"]</h2>
        <p>@L["Signed in as {0}", UserName]@(IsAdmin ? " (" + L["admin"] + ")" : "").</p>
        <div class="row form-row">
            <input placeholder="@L["Display name (shown on certificates and in the activity feed)"]" @bind="displayName" />
            <label class="toggle"><input type="checkbox" @bind="shareActivity" /> @L["Share my progress in the household feed"]</label>
            <button class="btn ghost small" @onclick="SaveProfile">@L["Save"]</button>
        </div>
        <div class="row form-row">
            <span class="muted tiny">@L["Language"]</span>
            @foreach (var (code, name) in Localizer.Languages)
            {
                <a class="chip @(Localizer.CurrentLanguage == code ? "active" : "")" href="@($"culture?culture={code}&redirect={AppPaths.Base}/settings")" target="_top">@name</a>
            }
        </div>
        <h3>@L["Change password"]</h3>
        <div class="row form-row">
            <input type="password" placeholder="@L["Current password"]" autocomplete="current-password" @bind="currentPassword" />
            <input type="password" placeholder="@L["New password (8+ characters)"]" autocomplete="new-password" @bind="newPassword" />
            <button class="btn ghost small" disabled="@(string.IsNullOrEmpty(currentPassword) || string.IsNullOrEmpty(newPassword))" @onclick="ChangeOwnPassword">@L["Change password"]</button>
        </div>
        @if (accountMessage is not null) { <p class="tiny @(accountFailed ? "error" : "good")">@accountMessage</p> }
        <form method="post" action="auth/logout" class="logout-form">
            <button class="btn ghost small" type="submit">@L["Sign out"]</button>
        </form>
    </section>

    <section class="panel" id="security">
        <h2>@L["Two-factor sign-in"]</h2>
        @if (Me?.TotpEnabled == true)
        {
            <p class="good"><Icon Name="circle-check" /> @L["On. Signing in asks for a code from your authenticator app."]</p>
            <p class="muted tiny">@L["{0} recovery codes left.", recoveryLeft]</p>
            @if (recoveryCodes is not null)
            {
                <p class="good tiny">@L["Save these recovery codes somewhere safe. Each works once if you lose your phone:"]</p>
                <div class="api-key recovery">@string.Join("   ", recoveryCodes)</div>
            }
            <div class="row form-row">
                <input placeholder="@L["Current code to turn it off"]" inputmode="numeric" autocomplete="one-time-code" @bind="totpCode" />
                <button class="btn ghost small" @onclick="DisableTotp">@L["Turn off"]</button>
            </div>
        }
        else if (totpSecret is not null)
        {
            <p>@L["Scan this with an authenticator app (Aegis, Google Authenticator, 1Password, Bitwarden…), then enter the 6-digit code it shows."]</p>
            <div class="lan">
                <div id="totp-qr" class="qr"></div>
                <div>
                    <p class="muted tiny">@L["Or type this key:"]</p>
                    <div class="api-key">@TotpService.Pretty(totpSecret)</div>
                    <div class="row form-row">
                        <input placeholder="123456" inputmode="numeric" autocomplete="one-time-code" @bind="totpCode" />
                        <button class="btn primary small" @onclick="ConfirmTotp">@L["Turn on"]</button>
                        <button class="btn ghost small" @onclick="() => totpSecret = null">@L["Cancel"]</button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <p class="muted tiny">@L["Protect your account with a code from your phone in addition to your password. Recommended if Lyceum is reachable from the internet. (Single sign-on accounts use your identity provider's two-factor instead.)"]</p>
            <button class="btn ghost small" @onclick="BeginTotp">@L["Set up two-factor sign-in"]</button>
        }
        @if (securityMessage is not null) { <p class="tiny @(securityFailed ? "error" : "good")">@securityMessage</p> }
    </section>

    <section class="panel" id="goals">
        <h2>@L["Daily goal & reminders"]</h2>
        <p class="muted tiny">@L["Set how many minutes you want to learn each day. At the time you choose, Lyceum sends a push notification to your ntfy topic if you haven't reached it yet (and when flashcards are due)."]</p>
        <div class="row form-row">
            <label class="field"><span>@L["Minutes per day"]</span><input type="number" min="0" max="600" @bind="goalMinutes" /></label>
            <label class="field"><span>@L["Remind me at"]</span><input type="time" @bind="reminderTime" /></label>
        </div>
        <div class="row form-row">
            <label class="field"><span>@L["Your ntfy topic URL"]</span><input placeholder="https://ntfy.sh/your-private-topic" @bind="reminderUrl" /></label>
            <label class="field"><span>@L["Access token (optional)"]</span><input type="password" autocomplete="off" placeholder="@(Me?.HasReminderToken == true ? "••••••••" : "")" @bind="reminderToken" /></label>
        </div>
        <div class="row">
            <button class="btn primary small" @onclick="SaveGoal">@L["Save"]</button>
            <button class="btn ghost small" disabled="@string.IsNullOrWhiteSpace(reminderUrl)" @onclick="TestReminder">@L["Send a test reminder"]</button>
        </div>
        @if (goalMessage is not null) { <p class="tiny @(goalFailed ? "error" : "good")">@goalMessage</p> }
    </section>

    @if (!IsKid)
    {
    <section class="panel" id="api">
        <h2>@L["API keys"]</h2>
        <p class="muted tiny">
            @L["For scripts and apps. Send the key as Authorization: Bearer <key>. Keys act as you and can see what you can see."]
            <a class="accent" href="openapi/v1.json" target="_blank">OpenAPI</a>
        </p>
        @if (newKey is not null)
        {
            <p class="good tiny">@L["Copy this key now — it won't be shown again:"]</p>
            <div class="api-key">@newKey</div>
        }
        @foreach (var k in apiKeys)
        {
            <div class="job">
                <span class="job-title">@k.Name <code>@k.Prefix…</code></span>
                <span class="muted tiny">@L["created {0}", Format.Ago(k.CreatedAt)] · @(k.LastUsedAt is { } u ? L["used {0}", Format.Ago(u)] : L["never used"])</span>
                <button class="icon-btn" title="@L["Delete"]" @onclick="() => DeleteKey(k)"><Icon Name="trash-2" /></button>
            </div>
        }
        <div class="row form-row">
            <input placeholder="@L["Key name, e.g. Home Assistant"]" @bind="newKeyName" />
            <button class="btn ghost small" @onclick="CreateKey">@L["Create key"]</button>
        </div>
    </section>
    }

    @if (IsAdmin)
    {
        <section class="panel" id="users">
            <h2>@L["Users"]</h2>
            <p class="muted tiny">@L["Everyone gets their own progress, notes, bookmarks, stats and learning paths. Admins see every library."]</p>
            <p class="muted tiny">@L["Single sign-on:"] @(Oidc.Enabled ? L["on ({0})", Oidc.Authority ?? ""] : L["off — set the Oidc__ environment variables to connect Authentik, Authelia, Keycloak…"])</p>
            <table class="stats-table users-table">
                <thead><tr><th>@L["User"]</th><th>@L["Role"]</th><th>@L["Kid profile"]</th>@if (Library.Libraries.Count > 1) { <th>@L["Libraries"]</th> }<th>@L["Last sign-in"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var u in users)
                    {
                        <tr>
                            <td>@u.Name @(u.Id == UserId ? "(" + L["you"] + ")" : "")<div class="muted tiny">@u.Username</div></td>
                            <td>
                                <label class="toggle">
                                    <input type="checkbox" checked="@u.IsAdmin" disabled="@(u.Id == UserId || u.IsKid)" @onchange="e => SetAdmin(u, (bool)e.Value!)" /> admin
                                </label>
                                @if (u.TotpEnabled) { <div class="tiny"><Icon Name="lock-keyhole" /> 2FA <button class="link" @onclick="() => ResetTotp(u)">@L["reset"]</button></div> }
                            </td>
                            <td>
                                @if (!u.IsAdmin)
                                {
                                    <label class="toggle tiny"><input type="checkbox" checked="@u.IsKid" @onchange="e => SetKid(u, (bool)e.Value!, u.DailyLimitMinutes)" /> @L["kid"]</label>
                                    @if (u.IsKid)
                                    {
                                        <label class="tiny limit"><Icon Name="hourglass" /> <input type="number" min="0" max="600" value="@(u.DailyLimitMinutes ?? 0)" @onchange="e => SetKid(u, true, int.TryParse(e.Value?.ToString(), out var m) ? m : null)" /> @L["min/day (0 = no limit)"]</label>
                                    }
                                }
                            </td>
                            @if (Library.Libraries.Count > 1)
                            {
                                <td>
                                    @if (u.IsAdmin) { <span class="muted tiny">@L["all"]</span> }
                                    else
                                    {
                                        <div class="access-list">
                                            @foreach (var lib in Library.Libraries)
                                            {
                                                <label class="toggle tiny"><input type="checkbox" checked="@(u.AllowedLibraries is null || u.AllowedLibraries.Contains(lib.Id))" @onchange="e => SetAccess(u, lib.Id, (bool)e.Value!)" /> @lib.Name</label>
                                            }
                                        </div>
                                    }
                                </td>
                            }
                            <td class="muted tiny">@(u.LastLoginAt is { } t ? Format.Ago(t) : L["never"])</td>
                            <td class="row">
                                @if (resetFor == u.Id)
                                {
                                    <input type="password" placeholder="@L["New password"]" autocomplete="new-password" @bind="resetPassword" />
                                    <button class="btn primary small" @onclick="() => ResetPassword(u)">@L["Save"]</button>
                                    <button class="btn ghost small" @onclick="() => resetFor = null">@L["Cancel"]</button>
                                }
                                else if (u.Id != UserId)
                                {
                                    <button class="btn ghost small" @onclick="() => { resetFor = u.Id; resetPassword = string.Empty; }">@L["Reset password"]</button>
                                    @if (confirmDelete == u.Id)
                                    {
                                        <button class="btn danger small" @onclick="() => DeleteUser(u)">@L["Delete {0} and all their data", u.Username]</button>
                                        <button class="btn ghost small" @onclick="() => confirmDelete = null">@L["Cancel"]</button>
                                    }
                                    else
                                    {
                                        <button class="btn ghost small" @onclick="() => confirmDelete = u.Id">@L["Delete"]</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <h3>@L["Add a user"]</h3>
            <div class="row form-row">
                <input placeholder="@L["Username"]" autocomplete="off" @bind="newUser" />
                <input type="password" placeholder="@L["Password (8+ characters)"]" autocomplete="new-password" @bind="newUserPassword" />
                <label class="toggle"><input type="checkbox" @bind="newUserAdmin" /> admin</label>
                <button class="btn primary small" @onclick="AddUser">@L["Add user"]</button>
            </div>
            @if (usersMessage is not null) { <p class="tiny @(usersFailed ? "error" : "good")">@usersMessage</p> }
        </section>

        <section class="panel" id="libraries">
            <h2>@L["Libraries"]</h2>
            <p class="muted tiny">@L["Each library is a folder of courses. Inside Docker, mount the folder into the container first and use the path inside the container (e.g. /media/kids)."]</p>
            @foreach (var lib in Library.Libraries)
            {
                <div class="job">
                    @if (editLib == lib.Id)
                    {
                        <input @bind="editLibName" />
                        @if (lib.Id != 1) { <input @bind="editLibPath" /> }
                        <button class="btn primary small" @onclick="() => SaveLibrary(lib)">@L["Save"]</button>
                        <button class="btn ghost small" @onclick="() => editLib = null">@L["Cancel"]</button>
                    }
                    else
                    {
                        <span class="job-title"><strong>@lib.Name</strong> <code>@lib.Root</code> @(lib.Id == 1 ? "· " + L["from configuration"] : "")</span>
                        <span class="muted tiny">@L["{0} courses", Library.Courses.Count(c => c.LibraryId == lib.Id)]</span>
                        <button class="icon-btn" title="@L["Edit"]" @onclick="() => { editLib = lib.Id; editLibName = lib.Name; editLibPath = lib.Root; }"><Icon Name="pencil" /></button>
                        @if (lib.Id != 1) { <button class="icon-btn" title="@L["Remove library (files stay on disk)"]" @onclick="() => RemoveLibrary(lib)"><Icon Name="trash-2" /></button> }
                    }
                </div>
            }
            <div class="row form-row">
                <input placeholder="@L["Name, e.g. Kids"]" @bind="newLibName" />
                <input placeholder="@L["Folder, e.g. /media/kids"]" @bind="newLibPath" />
                <button class="btn ghost small" @onclick="AddLibrary">@L["Add library"]</button>
                <button class="btn ghost small" @onclick="Rescan" disabled="@scanning">@if (scanning) { @L["Scanning…"] } else { <Icon Name="refresh-cw" /> @L["Rescan now"] }</button>
            </div>
            @if (libMessage is not null) { <p class="tiny @(libFailed ? "error" : "good")">@libMessage</p> }
            <p class="muted tiny">@L["Last scanned {0}. New, renamed or removed course folders are picked up automatically.", Format.Ago(Library.LastScan)]</p>
        </section>

        <section class="panel" id="playback">
            <h2>@L["Video playback"]</h2>
            <p class="muted tiny">@L["Videos a browser can't play (MKV, AVI, HEVC on some browsers, 10-bit…) are repackaged or converted to H.264 the first time someone opens them. Repackaging is quick and lossless; converting takes a while and uses the encoder below."]</p>
            <div class="row form-row">
                <label class="field"><span>@L["Encoder"]</span>
                    <select @bind="server.HardwareAcceleration">
                        @foreach (var (value, _, label) in MediaTools.HardwareOptions)
                        {
                            var available = value == "none" || Tools.HasEncoder(value);
                            <option value="@value" disabled="@(!available && server.HardwareAcceleration != value)">@L[label]@(available ? "" : " — " + L["not available in this ffmpeg"])</option>
                        }
                    </select>
                </label>
                @if (server.HardwareAcceleration != "none" && !Tools.HasEncoder(server.HardwareAcceleration))
                {
                    <p class="error tiny">@L["This server's ffmpeg doesn't have that encoder, so conversions will fail. Pick another option."]</p>
                }
                @if (server.HardwareAcceleration == "vaapi")
                {
                    <label class="field"><span>@L["VAAPI device"]</span><input @bind="server.VaapiDevice" /></label>
                }
                <label class="field"><span>@L["Keep converted videos up to (GB)"]</span><input type="number" min="1" max="2000" @bind="server.TranscodeCacheGb" /></label>
            </div>
            <label class="toggle"><input type="checkbox" @bind="server.AutoPrepareVideos" /> @L["Convert new videos in the background as soon as they're found"]</label>
            <div class="row">
                <button class="btn primary small" @onclick="SaveServer">@L["Save"]</button>
                <button class="btn ghost small" @onclick="PrepareAll" disabled="@preparingAll">@(preparingAll ? L["Checking videos…"] : L["Convert all incompatible videos now"])</button>
                <button class="btn ghost small" @onclick="ClearTranscodes">@L["Clear converted videos ({0})", Format.Bytes(transcodeBytes)]</button>
            </div>
            @if (serverMessage is not null) { <p class="tiny good">@serverMessage</p> }
            @JobList(Transcoder.Jobs.Select(j => (j.Title + (j.Variant == PlaybackVariant.Remux ? " (remux)" : " (H.264)"), j.State, j.Percent, j.Error)).ToList(), Transcoder.ClearFinished)
        </section>

        <section class="panel" id="transcripts">
            <h2>@L["Transcripts & subtitles"]</h2>
            <p class="muted tiny">@L["Subtitle files (.srt/.vtt) next to a video are used automatically. Everything else can be transcribed on this server with Whisper — nothing is uploaded."]</p>
            <ul class="checklist">
                <li class="@(Tools.Ffmpeg is null ? "bad" : "ok")">ffmpeg — @(Tools.Ffmpeg ?? L["not found"])</li>
                <li class="@(Tools.Whisper is null ? "bad" : "ok")">whisper.cpp — @(Tools.Whisper ?? L["not found"])</li>
                <li class="@(Tools.ModelPresent ? "ok" : "bad")">
                    @L["Speech model"]
                    <select @bind="server.WhisperModel" @bind:after="SaveServer">
                        @foreach (var (file, label) in WhisperModels) { <option value="@file">@label</option> }
                    </select>
                    @if (Tools.ModelPresent)
                    {
                        <span>@L["ready"]</span>
                    }
                    else if (Transcripts.ModelDownload is { Error: null } d)
                    {
                        <span>@L["downloading… {0}%", d.Percent.ToString("0")]</span>
                        <div class="bar"><span style="width:@(d.Percent.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                    }
                    else
                    {
                        <button class="btn primary small" @onclick="DownloadModel">@L["Download from Hugging Face"]</button>
                        @if (Transcripts.ModelDownload is { Error: { } err }) { <div class="error tiny">@L["Download failed:"] @err</div> }
                    }
                </li>
            </ul>
            <div class="row form-row">
                <label class="field"><span>@L["Spoken language"]</span>
                    <select @bind="server.WhisperLanguage" @bind:after="SaveServer" disabled="@(!Tools.ModelIsMultilingual)">
                        <option value="">@L["Default ({0})", "en"]</option>
                        <option value="auto">@L["Detect automatically"]</option>
                        @foreach (var (c, n) in SpokenLanguages) { <option value="@c">@n</option> }
                    </select>
                </label>
            </div>
            @if (!Tools.ModelIsMultilingual) { <p class="muted tiny">@L["English-only models (*.en) can't detect or translate other languages. Pick a multilingual model for non-English courses."]</p> }
            <label class="toggle"><input type="checkbox" @bind="server.TranslateToEnglish" @bind:after="SaveServer" disabled="@(!Tools.ModelIsMultilingual)" /> @L["Also create English captions for non-English lessons"]</label>
            <label class="toggle"><input type="checkbox" @bind="server.AutoTranscribeNewVideos" @bind:after="SaveServer" /> @L["Transcribe new videos automatically when they're added"]</label>
            <p>@L["{0} lessons have searchable transcripts.", indexed]</p>
            @if (Tools.CanTranscribe)
            {
                <div class="row">
                    <select @bind="courseToTranscribe">
                        <option value="">@L["Choose a course…"]</option>
                        @foreach (var c in Library.Courses.Where(c => c.VideoCount > 0))
                        {
                            <option value="@c.Id">@c.Title (@L["{0} left", c.AllLessons.Count(l => l.Kind == LessonKind.Video && !Transcripts.HasTranscript(l))])</option>
                        }
                    </select>
                    <button class="btn primary small" disabled="@string.IsNullOrEmpty(courseToTranscribe)" @onclick="QueueCourse">@L["Transcribe course"]</button>
                    <button class="btn ghost small" @onclick="QueueAll">@L["Transcribe everything"]</button>
                    @if (Transcripts.Jobs.Any(j => j.State is JobState.Queued or JobState.Running))
                    {
                        <button class="btn ghost small" @onclick="Transcripts.CancelAll">@L["Stop"]</button>
                    }
                </div>
            }
            @if (message is not null) { <p class="muted tiny">@message</p> }
            @JobList(Transcripts.Jobs.Select(j => (j.Title, j.State, j.Percent, j.Error)).ToList(), Transcripts.ClearFinished)
        </section>

        <section class="panel" id="ai">
            <h2>@L["AI study tools"]</h2>
            <p class="muted tiny">@L["Summaries, quizzes, flashcards, \"ask this course\" and caption translation. Works with any OpenAI-compatible server: Ollama (http://localhost:11434/v1), LM Studio, llama.cpp, vLLM — or a cloud provider, in which case transcripts are sent to it."]</p>
            <label class="toggle"><input type="checkbox" @bind="aiOn" /> @L["Turn on AI features"]</label>
            <div class="row form-row">
                <label class="field"><span>@L["Server URL"]</span><input @bind="aiBaseUrl" placeholder="http://localhost:11434/v1" /></label>
                <label class="field"><span>@L["Model"]</span><input @bind="aiModel" placeholder="llama3.2" /></label>
                <label class="field"><span>@L["Embedding model (for search by meaning)"]</span><input @bind="aiEmbedding" placeholder="nomic-embed-text" /></label>
                <label class="field"><span>@L["API key (if needed)"]</span><input type="password" @bind="aiKey" autocomplete="off" placeholder="@(string.IsNullOrEmpty(ai.ApiKey) ? "" : "••••••••")" /></label>
            </div>
            <div class="row">
                <button class="btn primary small" @onclick="SaveAi">@L["Save"]</button>
                <button class="btn ghost small" @onclick="TestAi" disabled="@testingAi">@(testingAi ? L["Testing…"] : L["Test connection"])</button>
            </div>
            @if (aiMessage is not null) { <p class="tiny @(aiFailed ? "error" : "good")">@aiMessage</p> }
            <p class="muted tiny">@L["Docker: to reach Ollama on the host, use http://host.docker.internal:11434/v1 and add extra_hosts: [\"host.docker.internal:host-gateway\"] to your compose file."]</p>
        </section>

        <section class="panel" id="notifications">
            <h2>@L["Notifications"]</h2>
            <p class="muted tiny">@L["Send events to ntfy (phone push notifications) or any webhook (Home Assistant, Discord via a bridge, n8n…)."]</p>
            <label class="field"><span>@L["Public address of Lyceum (for links in notifications)"]</span>
                <input @bind="server.PublicUrl" placeholder="https://courses.example.com" @bind:after="SaveServer" />
            </label>
            @foreach (var t in notify.Targets)
            {
                <div class="job">
                    <span class="job-title"><strong>@(t.Type == "ntfy" ? "ntfy" : "Webhook")</strong> <code>@t.Url</code></span>
                    <span class="muted tiny">@string.Join(", ", EventsOf(t))</span>
                    <button class="btn ghost small" @onclick="() => TestTarget(t)">@L["Test"]</button>
                    <button class="icon-btn" title="@L["Delete"]" @onclick="() => RemoveTarget(t)"><Icon Name="trash-2" /></button>
                </div>
            }
            <h3>@L["Add a destination"]</h3>
            <div class="row form-row">
                <select @bind="newTargetType">
                    <option value="ntfy">ntfy</option>
                    <option value="webhook">Webhook (JSON POST)</option>
                </select>
                <input placeholder="@(newTargetType == "ntfy" ? "https://ntfy.sh/my-courses" : "https://example.com/hook")" @bind="newTargetUrl" />
                <input type="password" placeholder="@L["Token (optional)"]" @bind="newTargetToken" autocomplete="off" />
            </div>
            <div class="row">
                <label class="toggle tiny"><input type="checkbox" @bind="newOnAdded" /> @L["New course"]</label>
                <label class="toggle tiny"><input type="checkbox" @bind="newOnRemoved" /> @L["Course removed"]</label>
                <label class="toggle tiny"><input type="checkbox" @bind="newOnTranscripts" /> @L["Transcripts finished"]</label>
                <label class="toggle tiny"><input type="checkbox" @bind="newOnCompleted" /> @L["Someone finished a course"]</label>
                <button class="btn ghost small" @onclick="AddTarget" disabled="@string.IsNullOrWhiteSpace(newTargetUrl)">@L["Add"]</button>
            </div>
            @if (notifyMessage is not null) { <p class="tiny @(notifyFailed ? "error" : "good")">@notifyMessage</p> }
        </section>
    }

    <section class="panel">
        <h2>@L["Watch on your phone or tablet"]</h2>
        @if (shareUrls.Count == 0)
        {
            <p class="muted">@L["Open Lyceum on your other devices using this server's address."]</p>
        }
        else
        {
            <div class="lan">
                <div id="qr" class="qr"></div>
                <div>
                    <p>@L["On your phone or tablet, open:"]</p>
                    @foreach (var u in shareUrls) { <div class="lan-url"><code>@u</code></div> }
                </div>
            </div>
        }
        <p class="muted tiny">@L["To install it like an app: iPhone/iPad — Safari → Share → Add to Home Screen. Android — Chrome → ⋮ → Install app. Use Save offline on a lesson to watch without internet."]</p>
    </section>

    @if (IsAdmin)
    {
        <section class="panel" id="guests">
            <h2>@L["Guest links"]</h2>
            <p class="muted tiny">@L["People can create links on a course's Overview tab. Each opens only that course, until it expires."]</p>
            @if (allGuestLinks.Count == 0) { <p class="muted">@L["No guest links."]</p> }
            @foreach (var g in allGuestLinks)
            {
                var gc = Library.GetCourseByFolder(g.CoursePath);
                <div class="job">
                    <span class="job-title"><strong>@g.Label</strong> · @(gc?.Title ?? g.CoursePath)</span>
                    <span class="muted tiny">@L["by {0}", g.CreatedBy] · @(g.Expired ? L["expired"] : L["until {0}", g.ExpiresAt.ToLocalTime().ToString("d MMM yyyy")]) · @L["{0} visits", g.Visits]</span>
                    <button class="icon-btn" title="@L["Revoke"]" @onclick="() => RevokeGuest(g)"><Icon Name="trash-2" /></button>
                </div>
            }
        </section>

        <section class="panel" id="server-backups">
            <h2>@L["Server backups"]</h2>
            <p class="muted tiny">@L["A daily zip of the database, sign-in keys and transcripts, kept in {0}. To restore, stop Lyceum and unzip it into /config.", Backups.Folder]</p>
            <div class="row form-row">
                <label class="toggle"><input type="checkbox" @bind="backupOn" /> @L["Back up every day"]</label>
                <label class="field"><span>@L["At (hour)"]</span><input type="number" min="0" max="23" @bind="backupHour" /></label>
                <label class="field"><span>@L["Keep"]</span><input type="number" min="1" max="90" @bind="backupKeep" /></label>
                <label class="toggle"><input type="checkbox" @bind="backupTranscripts" /> @L["Include transcripts"]</label>
            </div>
            <div class="row">
                <button class="btn primary small" @onclick="SaveBackups">@L["Save"]</button>
                <button class="btn ghost small" disabled="@Backups.Running" @onclick="BackupNow">@(Backups.Running ? L["Backing up…"] : L["Back up now"])</button>
            </div>
            @if (backupMessage is not null) { <p class="tiny good">@backupMessage</p> }
            @if (Backups.LastError is { } be) { <p class="error tiny">@L["Last backup failed:"] @be</p> }
            @foreach (var b in Backups.List())
            {
                <div class="job">
                    <span class="job-title"><a class="accent" href="@($"api/admin/backups/{b.Name}")" download>@b.Name</a></span>
                    <span class="muted tiny">@Format.Bytes(b.Size) · @Format.Ago(b.CreatedAt)</span>
                    <button class="icon-btn" title="@L["Delete"]" @onclick="() => { Backups.Delete(b.Name); }"><Icon Name="trash-2" /></button>
                </div>
            }
            <h3>@L["Monitoring"]</h3>
            @if (Config.GetValue<bool>("Lyceum:Metrics:Enabled"))
            {
                <p class="tiny"><Icon Name="circle-check" /> @L["Prometheus metrics are available at"] <code>@($"{Nav.BaseUri}metrics")</code>@(string.IsNullOrEmpty(Config["Lyceum:Metrics:Token"]) ? "" : " " + L["(bearer token required)"])</p>
            }
            else
            {
                <p class="muted tiny">@L["Set Lyceum__Metrics__Enabled=true (and optionally Lyceum__Metrics__Token) to expose Prometheus metrics at /metrics."]</p>
            }
        </section>
    }

    <section class="panel" id="backup">
        <h2>@L["Backup"]</h2>
        <p class="muted tiny">@L["Your own progress, notes, bookmarks, stats, favourites and learning paths, in one JSON file. A backup can be restored into any account."]</p>
        <div class="row">
            <a class="btn primary" href="api/export" download><Icon Name="download" /> @L["Export backup"]</a>
            <a class="btn ghost" href="api/notes.md" download><Icon Name="download" /> @L["Notes as Markdown"]</a>
        </div>
        <h3>@L["Restore"]</h3>
        <p class="muted tiny">@L["Restoring replaces everything currently saved in your account with the backup's contents."]</p>
        <label class="toggle"><input type="checkbox" @bind="confirmRestore" /> @L["I understand my current data will be replaced"]</label>
        <InputFile OnChange="Restore" accept=".json,application/json" disabled="@(!confirmRestore)" />
        @if (restoreMessage is not null) { <p class="tiny @(restoreFailed ? "error" : "good")">@restoreMessage</p> }
    </section>

    @if (IsAdmin)
    {
        <section class="panel">
            <h2>@L["Storage"]</h2>
            <p class="muted tiny">@L["Thumbnails, converted videos, transcripts and speech models live in {0}.", Tools.DataDir]</p>
            <p>@L["{0} thumbnails · {1} generated transcripts", thumbCount, transcriptCount]</p>
            <button class="btn ghost small" @onclick="ClearThumbs">@L["Clear thumbnails"]</button>
        </section>
    }
</main>

@code {
    private static readonly (string File, string Label)[] WhisperModels =
    [
        ("ggml-base.en.bin", "base.en — English, 148 MB, fast"),
        ("ggml-base.bin", "base — multilingual, 148 MB, fast"),
        ("ggml-small.en.bin", "small.en — English, 488 MB, better"),
        ("ggml-small.bin", "small — multilingual, 488 MB, better"),
        ("ggml-medium.bin", "medium — multilingual, 1.5 GB, slow"),
        ("ggml-large-v3-turbo.bin", "large-v3-turbo — multilingual, 1.6 GB, best"),
    ];

    private static readonly (string Code, string Name)[] SpokenLanguages =
    [
        ("en", "English"), ("de", "Deutsch"), ("es", "Español"), ("fr", "Français"), ("it", "Italiano"), ("pt", "Português"),
        ("nl", "Nederlands"), ("pl", "Polski"), ("tr", "Türkçe"), ("ru", "Русский"), ("uk", "Українська"), ("ar", "العربية"),
        ("hi", "हिन्दी"), ("ur", "اردو"), ("zh", "中文"), ("ja", "日本語"), ("ko", "한국어"),
    ];

    private List<string> shareUrls = [];
    private List<UserInfo> users = [];
    private List<ApiKeyInfo> apiKeys = [];
    private int indexed;
    private bool scanning;
    private string courseToTranscribe = "";
    private string? message;
    private bool confirmRestore;
    private string? restoreMessage;
    private bool restoreFailed;
    private int thumbCount, transcriptCount;
    private long transcodeBytes;
    private bool qrDrawn;

    private string displayName = "";
    private bool shareActivity = true;
    private string currentPassword = "", newPassword = "";
    private string? accountMessage;
    private bool accountFailed;

    // security
    private string? totpSecret;
    private string totpCode = "";
    private List<string>? recoveryCodes;
    private int recoveryLeft;
    private string? securityMessage;
    private bool securityFailed;
    private bool totpQrPending;

    // goals
    private int? goalMinutes;
    private TimeOnly? reminderTime;
    private string? reminderUrl, reminderToken;
    private string? goalMessage;
    private bool goalFailed;

    // guests & backups (admin)
    private List<GuestLinkInfo> allGuestLinks = [];
    private bool backupOn = true, backupTranscripts = true;
    private int backupHour = 3, backupKeep = 7;

    private string newKeyName = "";
    private string? newKey;

    private string newUser = "", newUserPassword = "";
    private bool newUserAdmin;
    private int? resetFor, confirmDelete;
    private string resetPassword = "";
    private string? usersMessage;
    private bool usersFailed;

    private int? editLib;
    private string editLibName = "", editLibPath = "", newLibName = "", newLibPath = "";
    private string? libMessage;
    private bool libFailed;

    private MutableServer server = new();
    private string? serverMessage;
    private bool preparingAll;

    private AiSettings ai = new();
    private string aiBaseUrl = "", aiModel = "", aiKey = "";
    private bool aiOn;
    private string aiEmbedding = "";
    private string? aiMessage;
    private bool aiFailed, testingAi;

    private NotificationSettings notify = new();
    private string newTargetType = "ntfy", newTargetUrl = "", newTargetToken = "";
    private bool newOnAdded = true, newOnRemoved, newOnTranscripts = true, newOnCompleted;
    private string? notifyMessage;
    private bool notifyFailed;

    /// <summary>Editable copy of <see cref="ServerSettings"/> (records are immutable).</summary>
    private sealed class MutableServer
    {
        public string? PublicUrl { get; set; }
        public bool AutoTranscribeNewVideos { get; set; }
        public bool AutoPrepareVideos { get; set; }
        public string HardwareAcceleration { get; set; } = "none";
        public string VaapiDevice { get; set; } = "/dev/dri/renderD128";
        public int TranscodeCacheGb { get; set; } = 50;
        public string? WhisperLanguage { get; set; }
        public string? WhisperModel { get; set; }
        public bool TranslateToEnglish { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await EnsureUserAsync();
        if (SendGuestToCourse()) return;
        Transcripts.Changed += OnChanged;
        Transcoder.Changed += OnChanged;
        shareUrls = ShareUrls();
        var me = await Users.GetAsync(UserId);
        displayName = me?.DisplayName ?? "";
        shareActivity = me?.ShareActivity ?? true;
        apiKeys = await ApiKeys.ListAsync(UserId);
        goalMinutes = me?.DailyGoalMinutes;
        reminderTime = TimeOnly.TryParse(me?.ReminderTime, out var rt) ? rt : null;
        reminderUrl = me?.ReminderUrl;
        recoveryLeft = me?.TotpEnabled == true ? await Users.RecoveryCodesLeftAsync(UserId) : 0;

        if (IsAdmin)
        {
            var s = await AppSettings.GetAsync<ServerSettings>();
            server = new MutableServer
            {
                PublicUrl = s.PublicUrl, AutoTranscribeNewVideos = s.AutoTranscribeNewVideos, AutoPrepareVideos = s.AutoPrepareVideos,
                HardwareAcceleration = s.HardwareAcceleration, VaapiDevice = s.VaapiDevice, TranscodeCacheGb = s.TranscodeCacheGb,
                WhisperLanguage = s.WhisperLanguage, WhisperModel = s.WhisperModel ?? Tools.ModelName, TranslateToEnglish = s.TranslateToEnglish,
            };
            ai = await AppSettings.GetAsync<AiSettings>();
            aiBaseUrl = ai.BaseUrl;
            aiOn = ai.Enabled;
            aiEmbedding = ai.EmbeddingModel ?? "";
            aiModel = ai.Model;
            notify = await AppSettings.GetAsync<NotificationSettings>();
            var b = await AppSettings.GetAsync<BackupSettings>();
            (backupOn, backupHour, backupKeep, backupTranscripts) = (b.Enabled, b.Hour, b.Keep, b.IncludeTranscripts);
            allGuestLinks = await Guests.ListAsync(UserId, true);
            await Tools.EncodersAsync(); // so the encoder list below shows what's really available
        }
        await Refresh();
    }

    private async Task Refresh()
    {
        if (!IsAdmin) return;
        users = await Users.ListAsync();
        indexed = await Transcripts.IndexedLessonCountAsync();
        thumbCount = Directory.EnumerateFiles(Tools.ThumbDir, "*.jpg").Count();
        transcriptCount = Directory.EnumerateFiles(Tools.TranscriptDir, "*.vtt").Count();
        transcodeBytes = Transcoder.CacheBytes();
    }

    private DateTime lastRefresh;

    private void OnChanged() => InvokeAsync(async () =>
    {
        // Progress events arrive often; only re-query counts every couple of seconds.
        if ((DateTime.UtcNow - lastRefresh).TotalSeconds > 2)
        {
            lastRefresh = DateTime.UtcNow;
            await Refresh();
        }
        StateHasChanged();
    });

    public void Dispose()
    {
        Transcripts.Changed -= OnChanged;
        Transcoder.Changed -= OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (totpQrPending && totpSecret is not null)
        {
            totpQrPending = false;
            var h = await JS.InvokeAsync<IJSObjectReference>("import", "./helpers.js");
            await h.InvokeVoidAsync("renderQr", "totp-qr", TotpService.ProvisioningUri(totpSecret, UserName));
        }
        if (!qrDrawn && shareUrls.Count > 0)
        {
            qrDrawn = true;
            var helpers = await JS.InvokeAsync<IJSObjectReference>("import", "./helpers.js");
            await helpers.InvokeVoidAsync("renderQr", "qr", shareUrls[0]);
        }
    }

    /// <summary>
    /// The address other devices should use: the one in the browser bar if it isn't "localhost"
    /// (e.g. behind a reverse proxy or on a NAS); otherwise this machine's LAN addresses.
    /// </summary>
    private List<string> ShareUrls()
    {
        var current = new Uri(Nav.BaseUri);
        if (!current.IsLoopback) return [current.GetLeftPart(UriPartial.Authority)];
        if (Environment.GetEnvironmentVariable("DOTNET_RUNNING_IN_CONTAINER") == "true") return [];
        return NetworkInterface.GetAllNetworkInterfaces()
            .Where(n => n.OperationalStatus == OperationalStatus.Up && n.NetworkInterfaceType != NetworkInterfaceType.Loopback)
            .SelectMany(n => n.GetIPProperties().UnicastAddresses)
            .Where(a => a.Address.AddressFamily == AddressFamily.InterNetwork && !System.Net.IPAddress.IsLoopback(a.Address)
                        && !a.Address.ToString().StartsWith("169.254."))
            .Select(a => $"{current.Scheme}://{a.Address}:{current.Port}")
            .Distinct()
            .ToList();
    }

    private RenderFragment JobList(List<(string Title, JobState State, int Percent, string? Error)> jobs, Action clear) => __builder =>
    {
        if (jobs.Count == 0) return;
        <div class="jobs">
            <div class="muted tiny">
                @L["{0} running · {1} queued · {2} done · {3} failed", jobs.Count(j => j.State == JobState.Running), jobs.Count(j => j.State == JobState.Queued), jobs.Count(j => j.State == JobState.Done), jobs.Count(j => j.State == JobState.Failed)]
                <button class="link" @onclick="clear">@L["clear finished"]</button>
            </div>
            @foreach (var j in jobs.Take(12))
            {
                <div class="job @j.State.ToString().ToLowerInvariant()">
                    <span class="job-title">@j.Title</span>
                    <span class="muted tiny">@(j.State switch { JobState.Running => $"{j.Percent}%", JobState.Failed => j.Error, _ => L[j.State.ToString()] })</span>
                </div>
            }
        </div>
    };

    // ---------- account ----------

    private async Task SaveProfile()
    {
        await Users.UpdateProfileAsync(UserId, displayName, shareActivity);
        accountFailed = false;
        accountMessage = L["Saved."];
    }

    private async Task ChangeOwnPassword()
    {
        var err = await Users.ChangePasswordAsync(UserId, currentPassword, newPassword);
        accountFailed = err is not null;
        accountMessage = err ?? L["Password changed. Other devices have been signed out; sign in again on them."];
        currentPassword = newPassword = "";
        if (err is null) Nav.NavigateTo("login?changed=1", forceLoad: true);
    }

    // ---------- security ----------

    private async Task BeginTotp()
    {
        totpSecret = await Users.BeginTotpSetupAsync(UserId, Totp);
        totpCode = "";
        totpQrPending = true;
        securityMessage = null;
    }

    private async Task ConfirmTotp()
    {
        var codes = await Users.ConfirmTotpAsync(UserId, totpCode, Totp);
        if (codes is null)
        {
            securityFailed = true;
            securityMessage = L["That code isn't right. Check the time on your phone and try the next code."];
            return;
        }
        recoveryCodes = codes;
        recoveryLeft = codes.Count;
        totpSecret = null;
        totpCode = "";
        securityFailed = false;
        securityMessage = L["Two-factor sign-in is on. Other devices will ask for a code next time."];
        Me = await Users.GetAsync(UserId);
    }

    private async Task DisableTotp()
    {
        if (!await Users.VerifySecondFactorAsync(UserId, totpCode, $"settings-2fa:{UserId}", Totp))
        {
            securityFailed = true;
            securityMessage = L["That code isn't right."];
            return;
        }
        await Users.DisableTotpAsync(UserId);
        totpCode = "";
        recoveryCodes = null;
        securityFailed = false;
        securityMessage = L["Two-factor sign-in is off."];
        Me = await Users.GetAsync(UserId);
    }

    private async Task ResetTotp(UserInfo u)
    {
        if (!IsAdmin) return;
        await Users.DisableTotpAsync(u.Id);
        Report(null, L["Two-factor sign-in reset for {0}.", u.Username]);
        await Refresh();
    }

    private async Task SetKid(UserInfo u, bool isKid, int? limit)
    {
        if (!IsAdmin) return;
        await Users.SetKidAsync(u.Id, isKid, limit);
        Report(null, isKid ? L["{0} has a kid profile.", u.Username] : L["{0} no longer has a kid profile.", u.Username]);
        await Refresh();
    }

    // ---------- goals ----------

    private async Task SaveGoal()
    {
        if (!string.IsNullOrWhiteSpace(reminderUrl) && !(Uri.TryCreate(reminderUrl.Trim(), UriKind.Absolute, out var u) && u.Scheme is "http" or "https"))
        {
            goalFailed = true;
            goalMessage = L["Enter a full http(s) URL."];
            return;
        }
        await Users.SetGoalAsync(UserId, goalMinutes, reminderTime?.ToString("HH:mm"), reminderUrl, reminderToken, keepToken: string.IsNullOrEmpty(reminderToken));
        reminderToken = null;
        Me = await Users.GetAsync(UserId);
        goalFailed = false;
        goalMessage = L["Saved."];
    }

    private async Task TestReminder()
    {
        await SaveGoal();
        if (goalFailed || Me?.ReminderUrl is null) return;
        var (title, msg, link) = await Reminders.ComposeAsync(Me, force: true);
        var token = (await Users.FindForSignInAsync(UserId))?.ReminderToken;
        var err = await Reminders.SendAsync(Me.ReminderUrl, token, title ?? "Lyceum", msg ?? "Reminders work. 🎉", link, allowPrivate: IsAdmin);
        goalFailed = err is not null;
        goalMessage = err is null ? L["Sent. Check your device."] : L["Failed: {0}", err];
    }

    // ---------- guests & backups (admin) ----------

    private async Task RevokeGuest(GuestLinkInfo g)
    {
        if (!IsAdmin) return;
        await Guests.RevokeAsync(g.Id, UserId, true);
        allGuestLinks = await Guests.ListAsync(UserId, true);
    }

    private async Task SaveBackups()
    {
        if (!IsAdmin) return;
        await AppSettings.SaveAsync(new BackupSettings
        {
            Enabled = backupOn, Hour = Math.Clamp(backupHour, 0, 23), Keep = Math.Clamp(backupKeep, 1, 90), IncludeTranscripts = backupTranscripts,
        });
        backupMessage = L["Saved."];
    }

    private string? backupMessage;

    private async Task BackupNow()
    {
        if (!IsAdmin) return;
        var name = await Backups.RunAsync();
        backupMessage = name is null ? null : L["Backup {0} created.", name];
    }

    private async Task CreateKey()
    {
        if (IsKid || IsGuest) return;
        newKey = await ApiKeys.CreateAsync(UserId, newKeyName);
        newKeyName = "";
        apiKeys = await ApiKeys.ListAsync(UserId);
    }

    private async Task DeleteKey(ApiKeyInfo k)
    {
        await ApiKeys.DeleteAsync(UserId, k.Id);
        apiKeys = await ApiKeys.ListAsync(UserId);
        newKey = null;
    }

    // ---------- users (admin) ----------

    private void Report(string? err, string ok)
    {
        usersFailed = err is not null;
        usersMessage = err ?? ok;
    }

    private async Task AddUser()
    {
        if (!IsAdmin) return;
        var (_, err) = await Users.CreateAsync(newUser, newUserPassword, newUserAdmin);
        Report(err, L["Added {0}.", newUser.Trim()]);
        if (err is null) { newUser = newUserPassword = ""; newUserAdmin = false; }
        await Refresh();
    }

    private async Task SetAdmin(UserInfo u, bool admin)
    {
        if (!IsAdmin) return;
        Report(await Users.SetAdminAsync(u.Id, admin), admin ? L["{0} is now an admin.", u.Username] : L["{0} is no longer an admin.", u.Username]);
        await Refresh();
    }

    private async Task SetAccess(UserInfo u, int libraryId, bool allowed)
    {
        if (!IsAdmin) return;
        var current = u.AllowedLibraries?.ToHashSet() ?? Library.Libraries.Select(l => l.Id).ToHashSet();
        if (allowed) current.Add(libraryId); else current.Remove(libraryId);
        var all = Library.Libraries.All(l => current.Contains(l.Id));
        await Users.SetLibraryAccessAsync(u.Id, all ? null : current);
        Report(null, L["Updated {0}'s libraries.", u.Username]);
        await Refresh();
    }

    private async Task ResetPassword(UserInfo u)
    {
        if (!IsAdmin) return;
        Report(await Users.ChangePasswordAsync(u.Id, null, resetPassword), L["Password for {0} changed.", u.Username]);
        resetFor = null;
        resetPassword = "";
    }

    private async Task DeleteUser(UserInfo u)
    {
        if (!IsAdmin) return;
        Report(await Users.DeleteAsync(u.Id), L["Deleted {0}.", u.Username]);
        confirmDelete = null;
        await Refresh();
    }

    // ---------- libraries (admin) ----------

    private void LibReport(string? err, string ok) { libFailed = err is not null; libMessage = err ?? ok; }

    private async Task AddLibrary()
    {
        if (!IsAdmin) return;
        var err = await Library.AddLibraryAsync(newLibName, newLibPath);
        LibReport(err, L["Added {0}.", newLibName]);
        if (err is null) newLibName = newLibPath = "";
    }

    private async Task SaveLibrary(LibraryInfo lib)
    {
        if (!IsAdmin) return;
        LibReport(await Library.UpdateLibraryAsync(lib.Id, editLibName, lib.Id == 1 ? null : editLibPath), L["Saved."]);
        editLib = null;
    }

    private async Task RemoveLibrary(LibraryInfo lib)
    {
        if (!IsAdmin) return;
        LibReport(await Library.RemoveLibraryAsync(lib.Id), L["Removed {0}. The files are still on disk.", lib.Name]);
    }

    private async Task Rescan()
    {
        if (!IsAdmin) return;
        scanning = true;
        await Library.RescanAsync();
        scanning = false;
    }

    // ---------- playback & transcripts (admin) ----------

    private async Task SaveServer()
    {
        if (!IsAdmin) return;
        await AppSettings.SaveAsync(new ServerSettings
        {
            PublicUrl = string.IsNullOrWhiteSpace(server.PublicUrl) ? null : server.PublicUrl.Trim().TrimEnd('/'),
            AutoTranscribeNewVideos = server.AutoTranscribeNewVideos,
            AutoPrepareVideos = server.AutoPrepareVideos,
            HardwareAcceleration = server.HardwareAcceleration,
            VaapiDevice = server.VaapiDevice,
            TranscodeCacheGb = Math.Clamp(server.TranscodeCacheGb, 1, 2000),
            WhisperLanguage = string.IsNullOrWhiteSpace(server.WhisperLanguage) ? null : server.WhisperLanguage,
            WhisperModel = server.WhisperModel,
            TranslateToEnglish = server.TranslateToEnglish,
        });
        serverMessage = L["Saved."];
        StateHasChanged();
    }

    private async Task PrepareAll()
    {
        if (!IsAdmin) return;
        preparingAll = true;
        var n = 0;
        foreach (var c in Library.Courses) n += await Transcoder.PrepareCourseAsync(c);
        preparingAll = false;
        serverMessage = n == 0 ? L["Every video already plays in browsers."] : L["Queued {0} videos for conversion.", n];
    }

    private async Task ClearTranscodes()
    {
        if (!IsAdmin) return;
        Transcoder.ClearCache();
        await Refresh();
    }

    private async Task DownloadModel()
    {
        if (!IsAdmin) return;
        await SaveServer();
        _ = Transcripts.DownloadModelAsync();
    }

    private void QueueAll()
    {
        if (IsAdmin) message = L["Queued {0} lessons.", Transcripts.EnqueueAll()];
    }

    private void QueueCourse()
    {
        if (IsAdmin && Library.GetCourse(courseToTranscribe) is { } c) message = L["Queued {0} lessons from {1}.", Transcripts.EnqueueCourse(c), c.Title];
    }

    // ---------- AI (admin) ----------

    private async Task SaveAi()
    {
        if (!IsAdmin) return;
        ai = ai with
        {
            Enabled = aiOn,
            EmbeddingModel = string.IsNullOrWhiteSpace(aiEmbedding) ? null : aiEmbedding.Trim(),
            BaseUrl = string.IsNullOrWhiteSpace(aiBaseUrl) ? "http://localhost:11434/v1" : aiBaseUrl.Trim().TrimEnd('/'),
            Model = string.IsNullOrWhiteSpace(aiModel) ? "llama3.2" : aiModel.Trim(),
            ApiKey = string.IsNullOrEmpty(aiKey) ? ai.ApiKey : aiKey,
        };
        await AppSettings.SaveAsync(ai);
        aiKey = "";
        aiFailed = false;
        aiMessage = L["Saved."];
    }

    private async Task TestAi()
    {
        if (!IsAdmin) return;
        await SaveAi();
        testingAi = true;
        var err = await Ai.TestAsync();
        testingAi = false;
        aiFailed = err is not null;
        aiMessage = err ?? L["It works: the model answered."];
    }

    // ---------- notifications (admin) ----------

    private IEnumerable<string> EventsOf(NotificationTarget t)
    {
        if (t.OnCourseAdded) yield return L["New course"];
        if (t.OnCourseRemoved) yield return L["Course removed"];
        if (t.OnTranscriptsDone) yield return L["Transcripts finished"];
        if (t.OnCourseCompleted) yield return L["Someone finished a course"];
    }

    private async Task AddTarget()
    {
        if (!IsAdmin || !Uri.TryCreate(newTargetUrl.Trim(), UriKind.Absolute, out var uri) || uri.Scheme is not ("http" or "https"))
        {
            notifyFailed = true;
            notifyMessage = L["Enter a full http(s) URL."];
            return;
        }
        notify = notify with
        {
            Targets = [.. notify.Targets, new NotificationTarget
            {
                Type = newTargetType, Url = uri.ToString(), Token = string.IsNullOrWhiteSpace(newTargetToken) ? null : newTargetToken.Trim(),
                OnCourseAdded = newOnAdded, OnCourseRemoved = newOnRemoved, OnTranscriptsDone = newOnTranscripts, OnCourseCompleted = newOnCompleted,
            }],
        };
        await AppSettings.SaveAsync(notify);
        newTargetUrl = newTargetToken = "";
        notifyFailed = false;
        notifyMessage = L["Added."];
    }

    private async Task RemoveTarget(NotificationTarget t)
    {
        if (!IsAdmin) return;
        notify = notify with { Targets = notify.Targets.Where(x => x.Id != t.Id).ToList() };
        await AppSettings.SaveAsync(notify);
    }

    private async Task TestTarget(NotificationTarget t)
    {
        if (!IsAdmin) return;
        var err = await Notifications.SendToAsync(t, new Notification("test", "Lyceum test", "Notifications from Lyceum work. 🎉", "/", null));
        notifyFailed = err is not null;
        notifyMessage = err is null ? L["Sent. Check your device."] : L["Failed: {0}", err];
    }

    private async Task Restore(InputFileChangeEventArgs e)
    {
        restoreFailed = false;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
            restoreMessage = await UserData.ImportAsync(UserId, stream);
            confirmRestore = false;
        }
        catch (Exception ex)
        {
            restoreFailed = true;
            restoreMessage = L["Restore failed:"] + " " + ex.Message;
        }
    }

    private async Task ClearThumbs()
    {
        if (!IsAdmin) return;
        foreach (var f in Directory.EnumerateFiles(Tools.ThumbDir)) File.Delete(f);
        await Refresh();
    }
}
