@page "/"
@inherits AppPage
@implements IDisposable
@inject CourseLibrary Library
@inject ProgressService ProgressService
@inject UserDataService UserData
@inject TranscriptService Transcripts
@inject ActivityService Activity
@inject WatchTimeService WatchTime
@inject ReviewService Reviews

<PageTitle>@L["Home"] · Lyceum</PageTitle>

<TopNav>
    <input class="search" type="search" placeholder="@L["Search courses, lessons and transcripts…"]" @bind="query" @bind:event="oninput" @bind:after="SearchTranscripts" />
    @if (IsAdmin)
    {
        <button class="btn ghost hide-mobile" @onclick="Rescan" disabled="@scanning" title="Pick up new or changed course folders">
            @if (scanning) { @("Scanning…") } else { <Icon Name="refresh-cw" /> @("Rescan") }
        </button>
    }
</TopNav>

<main class="home">
    @if (VisibleCourses.Count == 0)
    {
        <div class="empty">
            <h1>No courses found</h1>
            <p>Put each course in its own folder inside <code>@Library.RootPath</code>. New folders show up automatically.</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(query))
    {
        <h1 class="page-title">Results for “@query”</h1>
        @if (matchingCourses.Count > 0)
        {
            <div class="grid">
                @foreach (var c in matchingCourses) { @CourseCard(c) }
            </div>
        }
        @if (matchingLessons.Count > 0)
        {
            <h2 class="row-title">Lessons</h2>
            <ul class="lesson-results">
                @foreach (var (course, lesson) in matchingLessons.Take(60))
                {
                    <li>
                        <a href="@($"course/{course.Id}/{lesson.Id}")">
                            @LessonThumb(lesson)
                            <span class="t">@lesson.Title<span class="muted tiny block">@course.Title</span></span>
                            <span class="muted tiny">@Format.Clock(lesson.DurationSeconds)</span>
                        </a>
                    </li>
                }
            </ul>
        }
        @if (transcriptHits.Count > 0)
        {
            <h2 class="row-title">Said in a lesson</h2>
            <ul class="lesson-results">
                @foreach (var h in transcriptHits)
                {
                    <li>
                        <a href="@($"course/{h.Course.Id}/{h.Lesson.Id}?t={(int)h.Start}")">
                            @LessonThumb(h.Lesson)
                            <span class="t">
                                “@Highlight(h.Text)”
                                <span class="muted tiny block">@h.Lesson.Title · @h.Course.Title</span>
                            </span>
                            <span class="stamp">@Format.Clock(Math.Max(h.Start, 0.5))</span>
                        </a>
                    </li>
                }
            </ul>
        }
        @if (matchingCourses.Count == 0 && matchingLessons.Count == 0 && transcriptHits.Count == 0)
        {
            <p class="muted">Nothing matches.@(query.Trim().Length < 3 ? " Type at least 3 letters to search transcripts." : "")</p>
        }
    }
    else
    {
        <h1 class="page-title">@L["Welcome back, {0}", UserName]</h1>
        <div class="summary">
            <div><strong>@VisibleCourses.Count</strong><span>@L["courses"]</span></div>
            <div><strong>@VisibleCourses.Sum(c => c.LessonCount)</strong><span>@L["lessons"]</span></div>
            <div><strong>@Format.Long(VisibleCourses.Sum(c => c.TotalSeconds))</strong><span>@L["of video"]</span></div>
            <div><strong>@stats.Values.Sum(s => s.Completed)</strong><span>@L["lessons completed"]</span></div>
        </div>

        @if (Me?.DailyGoalMinutes is int goal || dueCards > 0)
        {
            <div class="today panel">
                @if (Me?.DailyGoalMinutes is int g)
                {
                    var pct = Math.Min(100, g == 0 ? 0 : 100.0 * todayMinutes / g);
                    <div class="goal">
                        <svg viewBox="0 0 36 36" class="ring big">
                            <circle cx="18" cy="18" r="15.5" class="ring-bg" />
                            <circle cx="18" cy="18" r="15.5" class="ring-fg" style="stroke-dasharray:@((pct * 0.974).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)) 100" />
                        </svg>
                        <div>
                            <strong class="with-icon">@if (todayMinutes >= g) { <Icon Name="party-popper" /> @L["Daily goal reached"] } else { @L["{0} of {1} minutes today", todayMinutes, g] }</strong>
                            <div class="muted tiny">@L["Your daily goal"] · <a class="accent" href="settings#account">@L["change"]</a></div>
                        </div>
                    </div>
                }
                @if (dueCards > 0)
                {
                    <a class="due-cards with-icon" href="review"><Icon Name="layers" /> @L["{0} flashcards to review", dueCards] <Icon Name="arrow-right" Class="trailing" /></a>
                }
            </div>
        }

        @if (inProgress.Count > 0)
        {
            <h2 class="row-title">@L["Continue learning"]</h2>
            <div class="continue">
                @foreach (var c in inProgress)
                {
                    var s = stats[c.Id];
                    <a class="continue-card" href="@($"{ResumeHref(c)}?play=1")" title="@L["Resume"]">
                        <div class="thumb small" style="@ThumbStyle(c, s.ResumeLesson)">
                            <span class="play"><Icon Name="play" /></span>
                        </div>
                        <div class="continue-body">
                            <div class="muted tiny">@c.Title</div>
                            <div class="continue-lesson">@s.ResumeLesson?.Title</div>
                            <div class="bar"><span style="width:@(s.Percent)%"></span></div>
                            <div class="muted tiny">@s.Percent% complete · @Format.Ago(s.LastWatched!.Value)</div>
                        </div>
                    </a>
                }
            </div>
        }

        @if (paths.Count > 0)
        {
            <h2 class="row-title">@L["Learning paths"] <a class="tiny accent" href="paths">@L["Manage"] <Icon Name="arrow-right" Class="trailing" /></a></h2>
            <div class="continue">
                @foreach (var p in paths)
                {
                    var courses = p.Items.Select(i => Library.GetCourseByFolder(i.CoursePath)).OfType<Course>().Where(c => stats.ContainsKey(c.Id)).ToList();
                    var done = courses.Sum(c => stats[c.Id].Completed);
                    var total = courses.Sum(c => stats[c.Id].Total);
                    var next = courses.FirstOrDefault(c => stats[c.Id].Completed < stats[c.Id].Total);
                    <a class="continue-card path-card" href="@(next is null ? "/paths" : ResumeHref(next))">
                        <div class="continue-body">
                            <div class="continue-lesson with-icon"><Icon Name="compass" /> @p.Name</div>
                            <div class="muted tiny">@courses.Count courses · next: @(next?.Title ?? "all done")</div>
                            <div class="bar"><span style="width:@(total == 0 ? 0 : 100 * done / total)%"></span></div>
                            <div class="muted tiny">@(total == 0 ? 0 : 100 * done / total)% complete</div>
                        </div>
                    </a>
                }
            </div>
        }

        @if (feed.Any(f => f.UserId != UserId))
        {
            <h2 class="row-title">@L["Household activity"]</h2>
            <ul class="feed panel">
                @foreach (var f in feed.Take(8))
                {
                    <li>
                        <span class="who">@(f.UserId == UserId ? L["You"] : f.UserName)</span>
                        <span>
                            @switch (f.Type)
                            {
                                case ActivityType.CourseStarted: @L["started"] break;
                                case ActivityType.CourseCompleted: <Icon Name="graduation-cap" /> @L["finished"] break;
                                default: @(f.Count == 1 ? L["completed a lesson in"] : L["completed {0} lessons in", f.Count]) break;
                            }
                        </span>
                        <a href="@($"course/{f.Course.Id}")">@f.Course.Title</a>
                        <span class="muted tiny push">@Format.Ago(f.At)</span>
                    </li>
                }
            </ul>
        }

        @if (suggestions.Count > 0)
        {
            <h2 class="row-title">
                @(inProgress.Count == 0 ? L["Pick a course to start"] : L["Start something new"])
                <a class="tiny accent" href="courses">@L["All {0} courses", VisibleCourses.Count] <Icon Name="arrow-right" Class="trailing" /></a>
            </h2>
            <div class="grid">
                @foreach (var c in suggestions) { @CourseCard(c) }
            </div>
        }
        else
        {
            <p class="row-title"><a class="accent" href="courses">@L["Browse all {0} courses", VisibleCourses.Count] <Icon Name="arrow-right" Class="trailing" /></a></p>
        }
    }
</main>

@code {
    private Dictionary<string, CourseStats> stats = [];
    private Dictionary<string, CourseMeta> meta = [];
    private List<Course> inProgress = [];
    private List<LearningPath> paths = [];
    private List<TranscriptHit> transcriptHits = [];
    private List<FeedItem> feed = [];
    private int todayMinutes;
    private int dueCards;
    private string query = "";
    private List<Course> suggestions = [];
    private bool scanning;

    private string Q => query.Trim();

    /// <summary>Courses in libraries this user can see.</summary>
    private List<Course> VisibleCourses => Library.CoursesFor(Access).ToList();

    private List<Course> matchingCourses => VisibleCourses
        .Where(c => c.Title.Contains(Q, StringComparison.OrdinalIgnoreCase) || (c.Author?.Contains(Q, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    private List<(Course, Lesson)> matchingLessons => VisibleCourses
        .SelectMany(c => c.AllLessons.Select(l => (c, l)))
        .Where(x => x.l.Title.Contains(Q, StringComparison.OrdinalIgnoreCase)).ToList();

    private CourseMeta MetaOf(Course c) => meta.GetValueOrDefault(c.FolderName) ?? new CourseMeta();

    protected override async Task OnInitializedAsync()
    {
        await EnsureUserAsync();
        if (SendGuestToCourse()) return;
        Library.Changed += OnLibraryChanged;
        await LoadStats();
    }

    private void OnLibraryChanged() => InvokeAsync(async () => { await LoadStats(); StateHasChanged(); });
    public void Dispose() => Library.Changed -= OnLibraryChanged;

    private async Task LoadStats()
    {
        stats = await ProgressService.StatsAsync(UserId, Library.CoursesFor(Access).ToList());
        meta = await UserData.AllMetaAsync(UserId);
        paths = (await UserData.PathsAsync(UserId)).Where(p => p.Items.Count > 0).ToList();
        feed = await Activity.FeedAsync(UserId, Access);
        todayMinutes = (int)Math.Round(await WatchTime.TodaySecondsAsync(UserId) / 60);
        dueCards = (await Reviews.CountsAsync(UserId, Access)).Due;
        inProgress = Library.CoursesFor(Access)
            .Where(c => stats[c.Id].Started && stats[c.Id].Completed < stats[c.Id].Total && !MetaOf(c).Archived)
            .OrderByDescending(c => stats[c.Id].LastWatched)
            .Take(6)
            .ToList();
        // Not started yet: favourites first, then alphabetical. A fresh library shows more.
        suggestions = VisibleCourses
            .Where(c => !stats[c.Id].Started && !MetaOf(c).Archived)
            .OrderByDescending(c => MetaOf(c).Favorite).ThenBy(c => c.Title, StringComparer.OrdinalIgnoreCase)
            .Take(inProgress.Count == 0 ? 12 : 4)
            .ToList();
    }

    private async Task SearchTranscripts()
    {
        var q = Q;
        if (q.Length < 3) { transcriptHits = []; return; }
        await Task.Delay(250); // debounce typing
        if (q != Q) return;
        transcriptHits = await Transcripts.SearchAsync(q, Access);
    }

    private async Task Rescan()
    {
        scanning = true;
        await Library.RescanAsync();
        await LoadStats();
        scanning = false;
    }

    private async Task ToggleFavorite(Course c)
    {
        var m = await UserData.UpdateMetaAsync(UserId, c, x => x.Favorite = !x.Favorite);
        meta[c.FolderName] = m;
    }

    private string ResumeHref(Course c) =>
        stats.TryGetValue(c.Id, out var s) && s.ResumeLesson is not null ? $"course/{c.Id}/{s.ResumeLesson.Id}" : $"course/{c.Id}";

    private string ThumbStyle(Course c, Lesson? lesson = null)
    {
        // A course's own cover wins; otherwise show the lesson you'll resume.
        var img = c.CoverPath is null && lesson is { Kind: LessonKind.Video } ? lesson.ThumbUrl : c.CoverUrl;
        return $"background-image:url('{img}'), {Format.Gradient(c.Title)}";
    }

    private MarkupString Highlight(string text)
    {
        var enc = System.Net.WebUtility.HtmlEncode(text);
        var q = System.Net.WebUtility.HtmlEncode(Q);
        var i = enc.IndexOf(q, StringComparison.OrdinalIgnoreCase);
        return i < 0 ? new MarkupString(enc) : new MarkupString($"{enc[..i]}<mark>{enc.Substring(i, q.Length)}</mark>{enc[(i + q.Length)..]}");
    }

    private RenderFragment LessonThumb(Lesson l) => __builder =>
    {
        if (l.Kind == LessonKind.Video)
        {
            <span class="lthumb" style="background-image:url('@l.ThumbUrl')"></span>
        }
        else
        {
            <span class="lthumb doc"><Icon Name="file-text" /></span>
        }
    };

    private RenderFragment CourseCard(Course c) => __builder =>
    {
        <CourseCard @key="c.Id" Course="c" Stats="@stats.GetValueOrDefault(c.Id)" Favorite="@MetaOf(c).Favorite" OnToggleFavorite="() => ToggleFavorite(c)" />
    };
}
