    public async ValueTask DisposeAsync()
    {
        Library.Changed -= OnLibraryChanged;
        Transcripts.Changed -= OnServiceChanged;
        Transcoder.Changed -= OnTranscoderChanged;
        Transcoder.Changed -= OnAudioMaybeReady;
        sleepCts?.Cancel();
        CancelCountdown();
        askCts?.Cancel();
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("detach");
                await module.DisposeAsync();
                if (offline is not null) await offline.DisposeAsync();
                if (cast is not null) await cast.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        selfRef?.Dispose();
    }
}
