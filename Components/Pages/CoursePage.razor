    private string? transcriptLanguage;
    private string translateTo = "";
    private int? translatePercent;
    private string? translateError;

    private RenderFragment TranscriptTab() => __builder =>
    {
        if (lesson!.Kind != LessonKind.Video)
        {
            <p class="muted">@L["Reading lessons don't have transcripts."]</p>
            return;
        }
        var tracks = Transcripts.Tracks(lesson);
        var cues = Transcripts.GetCues(lesson, transcriptLanguage);
        if (cues.Count > 0)
        {
            <div class="transcript-head">
                <label class="toggle"><input type="checkbox" id="transcript-follow" checked /> @L["Follow along"]</label>
                @if (tracks.Count > 1)
                {
                    <select @bind="transcriptLanguage">
                        @foreach (var t in tracks) { <option value="@(t.IsOriginal ? "" : t.Language)">@t.Label</option> }
                    </select>
                }
                <span class="muted tiny">@L["Click a line to jump there. Press C to toggle captions on the video."]</span>
            </div>
            <div class="transcript" id="transcript">
                @foreach (var c in cues)
                {
                    <p data-s="@c.Start.ToString(System.Globalization.CultureInfo.InvariantCulture)"><span class="stamp">@Format.Clock(Math.Max(c.Start, 0.5))</span> @c.Text</p>
                }
            </div>
            @if (aiEnabled)
            {
                <div class="row translate-row">
                    <span class="muted tiny">@L["Translate captions with AI:"]</span>
                    <select @bind="translateTo">
                        <option value="">@L["Choose a language…"]</option>
                        @foreach (var (langCode, langName) in CaptionLanguages.Where(x => tracks.All(t => t.Language != x.Code)))
                        {
                            <option value="@langCode">@langName</option>
                        }
                    </select>
                    <button class="btn ghost small" disabled="@(translateTo == "" || translatePercent is not null)" @onclick="TranslateCaptions">
                        @(translatePercent is { } tp ? L["Translating… {0}%", tp] : L["Translate"])
                    </button>
                    @if (translateError is not null) { <span class="error tiny">@translateError</span> }
                </div>
            }
            return;
        }
        var job = Transcripts.JobFor(lesson);
        <div class="panel">
            <h3>@L["No transcript yet"]</h3>
            @if (job is { State: JobState.Queued })
            {
                <p>@L["Queued for transcription… ({0} waiting)", Transcripts.Jobs.Count(j => j.State == JobState.Queued)]</p>
            }
            else if (job is { State: JobState.Running })
            {
                <p>@L["Transcribing… {0}%", job.Percent]</p>
                <div class="bar"><span style="width:@(job.Percent)%"></span></div>
            }
            else if (job is { State: JobState.Failed })
            {
                <p class="error">@L["Transcription failed:"] @job.Error</p>
            }
            @if (Tools.CanTranscribe && IsAdmin)
            {
                <p class="muted">@L["Transcripts are made on the server with Whisper. A lesson takes roughly a tenth of its length."]</p>
                <div class="row">
                    <button class="btn primary" disabled="@(job is { State: JobState.Queued or JobState.Running })" @onclick="() => Transcripts.Enqueue(lesson)">@L["Transcribe this lesson"]</button>
                    <button class="btn ghost" @onclick="() => Transcripts.EnqueueCourse(course!)">@L["Transcribe whole course"]</button>
                </div>
            }
            else if (Tools.CanTranscribe)
            {
                <p class="muted">@L["Ask an admin to transcribe this course."]</p>
            }
            else
            {
                <p class="muted">@L["Put an .srt or .vtt file next to the video with the same name."]</p>
            }
        </div>
    };

    private static readonly (string Code, string Name)[] CaptionLanguages =
    [
        ("en", "English"), ("de", "Deutsch"), ("es", "Español"), ("fr", "Français"), ("it", "Italiano"), ("pt", "Português"),
        ("nl", "Nederlands"), ("pl", "Polski"), ("tr", "Türkçe"), ("ru", "Русский"), ("uk", "Українська"), ("ar", "العربية"),
        ("hi", "हिन्दी"), ("ur", "اردو"), ("bn", "বাংলা"), ("zh", "中文"), ("ja", "日本語"), ("ko", "한국어"), ("id", "Bahasa Indonesia"), ("vi", "Tiếng Việt"),
    ];

    private async Task TranslateCaptions()
    {
        if (lesson is null || translateTo == "") return;
        var target = lesson;
        var lang = translateTo;
        translateError = null;
        translatePercent = 0;
        try
        {
            await Ai.TranslateCaptionsAsync(target, lang, new Progress<int>(p => InvokeAsync(() => { translatePercent = p; StateHasChanged(); })));
            if (lesson?.Id == target.Id) transcriptLanguage = lang;
        }
        catch (Exception ex)
        {
            translateError = ex.Message;
        }
        finally
        {
            translatePercent = null;
            translateTo = "";
        }
    }

