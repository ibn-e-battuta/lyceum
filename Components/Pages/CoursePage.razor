    private async Task ToggleAudio()
    {
        if (lesson is null || module is null) return;
        if (MediaSrc is not null) resumeOverride = await module.InvokeAsync<double>("getTime");
        audioMode = !audioMode;
        await module.InvokeVoidAsync("setPref", "lyceum.audio", audioMode);
        if (audioMode) Transcoder.Enqueue(lesson, PlaybackVariant.Audio);
    }

    private async Task ApplySleep()
    {
        sleepCts?.Cancel();
        sleepAt = null;
        sleepAfterLesson = sleepChoice == -1;
        if (sleepChoice <= 0) return;
        var cts = sleepCts = new CancellationTokenSource();
        sleepAt = DateTime.UtcNow.AddMinutes(sleepChoice);
        try
        {
            await Task.Delay(TimeSpan.FromMinutes(sleepChoice), cts.Token);
            if (module is not null) await module.InvokeVoidAsync("fadeOutAndPause", 8);
            sleepAt = null;
            sleepChoice = 0;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    private async Task ToggleCast()
    {
        if (cast is null || lesson is null || course is null || videoSrc is null) return;
        if (casting) { await cast.InvokeVoidAsync("stop"); return; }

        // The Chromecast fetches media itself, so it needs absolute URLs it can reach and a signed token instead of our cookie.
        var publicUrl = (await AppSettings.GetAsync<ServerSettings>()).PublicUrl?.TrimEnd('/');
        var origin = publicUrl is not null ? new Uri(publicUrl).GetLeftPart(UriPartial.Authority) : new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority);
        if (new Uri(origin).IsLoopback)
        {
            castError = L["Casting needs an address your Chromecast can reach. Open Lyceum by its network address, or set the public address in Settings → Notifications."];
            return;
        }
        if (await CastTokens.CreateAsync(UserId, lesson, course) is not { } rawToken) return;
        var token = Uri.EscapeDataString(rawToken);
        string Signed(string path) => origin + path + (path.Contains('?') ? "&" : "?") + "cast=" + token;
        var position = module is null ? 0 : await module.InvokeAsync<double>("getTime");
        if (module is not null) await module.InvokeVoidAsync("pause");
        await cast.InvokeVoidAsync("castLesson", new
        {
            lessonId = lesson.Id,
            url = Signed(videoSrc),
            contentType = videoSrc.Contains("?v=") ? "video/mp4" : media?.IsWebm == true ? "video/webm" : "video/mp4",
            title = lesson.Title,
            subtitle = course.Title,
            image = Signed(course.CoverPath is not null ? $"{AppPaths.Base}/cover/{course.Id}" : lesson.ThumbUrl),
            startTime = position,
            tracks = Transcripts.Tracks(lesson).Select((t, i) => new
            {
                id = i + 1, language = t.Language, name = t.Label,
                url = Signed(lesson.SubtitleUrl + (t.IsOriginal ? "" : "?lang=" + t.Language)),
            }).ToList(),
        }, selfRef);
    }

