@page "/course/{CourseId}/{LessonId}"
@inherits AppPage
@implements IAsyncDisposable
@inject CourseLibrary Library
@inject ProgressService ProgressService
@inject UserDataService UserData
@inject TranscriptService Transcripts
@inject MediaTools Tools
@inject MediaProbe Probe
@inject Transcoder Transcoder
@inject AiService Ai
@inject WatchTimeService WatchTime
@inject CommentService Comments
@inject ReviewService Reviews
@inject GuestService Guests
@inject CastTokenService CastTokens
@inject AppSettingsService AppSettings
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (course is null || lesson is null)
{
    <div class="empty"><h1>@L["Course not found"]</h1><a href="courses">@L["Back to my courses"]</a></div>
}
else
{
<PageTitle>@lesson.Title · @course.Title</PageTitle>

<header class="topbar player-top">
    <a class="brand" href="./" title="@L["Home"]"><span class="logo" aria-hidden="true"></span></a>
    <a class="course-title" href="@($"course/{course.Id}")" title="@L["Course details"]">← @course.Title</a>
    <button class="icon-btn @(meta.Favorite ? "on" : "")" title="@(meta.Favorite ? L["Remove from favourites"] : L["Add to favourites"])" @onclick="ToggleFavorite">@(meta.Favorite ? "★" : "☆")</button>
    <div class="top-progress" title="@L["{0} of {1} lessons complete", stats.Completed, stats.Total]">
        <svg viewBox="0 0 36 36" class="ring">
            <circle cx="18" cy="18" r="15.5" class="ring-bg" />
            <circle cx="18" cy="18" r="15.5" class="ring-fg" style="stroke-dasharray:@(stats.Percent * 0.974) 100" />
        </svg>
        <span>@L["{0} / {1} complete", stats.Completed, stats.Total]</span>
    </div>
    <button class="btn ghost hide-mobile" @onclick="() => sidebarOpen = !sidebarOpen">@(sidebarOpen ? L["Hide content"] : L["Show content"])</button>
</header>

<div class="player-layout @(sidebarOpen ? "" : "sidebar-closed")">
    <section class="stage">
        <div class="viewer @(lesson.Kind == LessonKind.Article ? "article" : "")" @ref="viewerRef">
            @if (lesson.Kind == LessonKind.Video)
            {
                <div class="video-wrap @(AudioActive ? "audio" : "")">
                    @if (timeUp)
                    {
                        <div class="preparing">
                            <div class="big-emoji">⏳</div>
                            <strong>@L["That's all for today"]</strong>
                            <div class="muted tiny">@L["You've used today's {0} minutes. See you tomorrow!", Me?.DailyLimitMinutes ?? 0]</div>
                        </div>
                    }
                    else if (AudioActive)
                    {
                        <div class="audio-art" style="background-image:url('@(course.CoverPath is not null ? course.CoverUrl : lesson.ThumbUrl)')">
                            <div class="audio-meta">
                                <div class="tiny">🎧 @L["Listening mode"]</div>
                                <strong>@lesson.Title</strong>
                                <div class="tiny">@course.Title</div>
                            </div>
                        </div>
                        <audio @key="AttachKey" @ref="videoRef" src="@MediaSrc" controls preload="auto"></audio>
                    }
                    else if (videoSrc is not null)
                    {
                        <video @key="AttachKey" @ref="videoRef" src="@videoSrc" poster="@(Tools.Ffmpeg is not null ? lesson.ThumbUrl : null)" controls playsinline preload="auto">
                            @foreach (var t in Transcripts.Tracks(lesson))
                            {
                                <track kind="subtitles" srclang="@t.Language" label="@t.Label" src="@($"{lesson.SubtitleUrl}{(t.IsOriginal ? "" : "?lang=" + t.Language)}")" />
                            }
                        </video>
                    }
                    else
                    {
                        <div class="preparing">
                            @if (playbackError is not null)
                            {
                                <div class="error">@playbackError</div>
                            }
                            else if (PrepJob is { } job)
                            {
                                <div class="spinner"></div>
                                <div>@(job.Variant == PlaybackVariant.Remux ? L["Preparing this video for your browser…"] : L["Converting this video for your browser…"])</div>
                                @if (job.State == JobState.Running)
                                {
                                    <div class="bar"><span style="width:@(job.Percent)%"></span></div>
                                    <div class="muted tiny">@job.Percent% · @L["you can keep browsing; it continues in the background"]</div>
                                }
                                else if (job.State == JobState.Queued)
                                {
                                    <div class="muted tiny">@L["Waiting for other conversions to finish…"]</div>
                                }
                                else if (job.State == JobState.Failed)
                                {
                                    <div class="error tiny">@job.Error</div>
                                    <button class="btn ghost small" @onclick="RetryPrepare">@L["Try again"]</button>
                                }
                            }
                            else
                            {
                                <div class="spinner"></div>
                            }
                        </div>
                    }
                    <button class="mini-close" title="@L["Back to the player"]">↑</button>
                    <div class="toast" id="player-toast"></div>
                </div>
            }
            else
            {
                <iframe @key="lesson.Id" src="@lesson.MediaUrl" title="@lesson.Title"
                        sandbox="allow-scripts allow-same-origin allow-popups allow-forms allow-downloads allow-popups-to-escape-sandbox"></iframe>
            }

            @if (countdown is not null && nextLesson is not null)
            {
                <div class="up-next">
                    @if (nextLesson.Kind == LessonKind.Video)
                    {
                        <div class="up-next-thumb" style="background-image:url('@nextLesson.ThumbUrl')"></div>
                    }
                    <div class="muted tiny">@L["Up next"]</div>
                    <div class="up-next-title">@nextLesson.Title</div>
                    <div class="up-next-actions">
                        <button class="btn primary" @onclick="GoNext">@L["Play now ({0})", countdown]</button>
                        <button class="btn ghost" @onclick="CancelCountdown">@L["Cancel"]</button>
                    </div>
                </div>
            }
        </div>

        @if (Chapters.Count > 0 && videoSrc is not null)
        {
            var total = media?.Duration ?? lesson.DurationSeconds ?? Chapters[^1].End;
            <div class="chapter-bar" id="chapter-bar" data-duration="@total.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                @foreach (var ch in Chapters)
                {
                    <button style="flex:@((ch.End - ch.Start).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))" title="@Format.Clock(Math.Max(ch.Start, 0.5)) · @ch.Title"
                            @onclick="() => Seek(ch.Start)"></button>
                }
                <span class="playhead"></span>
            </div>
        }

        <div class="lesson-bar">
            <button class="btn ghost" disabled="@(prevLesson is null)" @onclick="GoPrev" title="@L["Previous lesson"]">‹ @L["Prev"]</button>
            <div class="lesson-heading">
                <h1>@lesson.Title</h1>
                <div class="muted tiny">@SectionTitle(CurrentSection?.FullTitle) · @L["Lesson {0} of {1}", lessonIndex + 1, lessons.Count]</div>
            </div>
            <button class="btn ghost" disabled="@(nextLesson is null)" @onclick="GoNext" title="@L["Next lesson (N)"]">@L["Next"] ›</button>
        </div>

        <div class="lesson-tools">
            <button class="btn @(IsDone(lesson) ? "done" : "primary")" @onclick="() => ToggleComplete(lesson)">
                @(IsDone(lesson) ? "✓ " + L["Completed"] : L["Mark as complete"])
            </button>
            @if (lesson.Kind == LessonKind.Video)
            {
                <button class="btn ghost" title="@L["Bookmark this moment (B)"]" @onclick="AddBookmarkNow">🔖 @L["Bookmark"]</button>
                <button class="btn ghost hide-mobile" title="@L["Picture-in-picture (P)"]" @onclick="TogglePip" disabled="@AudioActive">⧉ PiP</button>
                <button class="btn @(audioMode ? "done" : "ghost")" title="@L["Audio only, like a podcast; keeps playing with the screen off"]" @onclick="ToggleAudio" disabled="@(videoSrc is null || media?.AudioCodec is null && media is not null)">
                    🎧 @(audioMode && !AudioActive ? L["Preparing audio…"] : L["Listen"])
                </button>
                <label class="speed" title="@L["Pause playback after a while"]">
                    ⏾
                    <select @bind="sleepChoice" @bind:after="ApplySleep">
                        <option value="0">@L["Sleep timer"]</option>
                        @foreach (var m in new[] { 10, 15, 30, 45, 60, 90 }) { <option value="@m">@L["{0} min", m]</option> }
                        <option value="-1">@L["End of this lesson"]</option>
                    </select>
                    @if (sleepAt is { } at) { <span class="tiny muted">@at.ToLocalTime().ToString("HH:mm")</span> }
                </label>
                @if (castAvailable)
                {
                    <button class="btn @(casting ? "done" : "ghost")" title="@L["Play on a Chromecast or Google TV"]" @onclick="ToggleCast" disabled="@(videoSrc is null)">📺 @(casting ? L["Casting"] : L["Cast"])</button>
                }
                @if (kidRemaining is { } left && !timeUp)
                {
                    <span class="kid-timer" title="@L["Time left today"]">⏳ @L["{0} min left today", (int)Math.Ceiling(left / 60)]</span>
                }
                @if (CanSaveOffline)
                {
                    <button class="btn ghost" title="@L["Keep a copy on this device to watch without internet"]" disabled="@(videoSrc is null || offlineProgress is not null)" @onclick="ToggleOffline">
                        @(offlineSaved ? "✓ " + L["Saved offline"] : offlineProgress is { } op ? L["Saving… {0}%", op] : "⬇ " + L["Save offline"])
                    </button>
                }
                <label class="toggle">
                    <input type="checkbox" @bind="autoplay" @bind:after="SaveAutoplay" /> @L["Autoplay next"]
                </label>
                <label class="speed">
                    @L["Speed"]
                    <select @bind="playbackRate" @bind:after="ApplyRate">
                        @foreach (var r in RateOptions) { <option value="@r">@(r.ToString("0.##"))×</option> }
                    </select>
                </label>
            }
            else
            {
                <a class="btn ghost" href="@lesson.MediaUrl" target="_blank">@L["Open in new tab"] ↗</a>
            }
            @if (lesson.Attachments.Count > 0)
            {
                <button class="btn ghost" @onclick='() => SetTab("Resources")'>📎 @lesson.Attachments.Count</button>
            }
        </div>
        @if (castError is not null) { <p class="error tiny cast-error">@castError</p> }

        <nav class="tabs">
            @foreach (var t in TabNames.Where(t => (t != "Chapters" || Chapters.Count > 0) && (t != "Discussion" || !IsGuest)))
            {
                <button class="@(tab == t ? "active" : "")" @onclick="() => SetTab(t)">
                    @L[t]
                    @if (TabCount(t) is int n && n > 0) { <span class="count">@n</span> }
                </button>
            }
        </nav>

        <div class="tab-body">
            @switch (tab)
            {
                case "Overview": @OverviewTab() break;
                case "Notes": @NotesTab(NoteKind.Note) break;
                case "Bookmarks": @NotesTab(NoteKind.Bookmark) break;
                case "Chapters": @ChaptersTab() break;
                case "Transcript": @TranscriptTab() break;
                case "Study": @StudyTab() break;
                case "Discussion": @DiscussionTab() break;
                case "Resources": @ResourcesTab() break;
            }
        </div>
    </section>

    <aside class="curriculum">
        <div class="curriculum-head">
            <h2>@L["Course content"]</h2>
            <span class="muted tiny">@L["{0} lessons", course.LessonCount]@(course.TotalSeconds > 0 ? $" · {Format.Long(course.TotalSeconds)}" : "")</span>
        </div>
        @foreach (var (section, si) in course.Sections.Select((s, i) => (s, i)))
        {
            var open = openSections.Contains(si);
            var done = section.Lessons.Count(IsDone);
            var top = TopFolder(section);
            var groupMembers = GroupIndexes(top);
            var grouped = groupMembers.Count > 1;
            @if (grouped && groupMembers[0] == si)
            {
                // Header for a top-level folder with nested chapters, e.g. "Part One".
                var members = groupMembers.Select(i => course.Sections[i]).ToList();
                var groupOpen = groupMembers.Any(openSections.Contains);
                <button class="group-head @(groupOpen ? "open" : "")" @onclick="() => ToggleGroup(groupMembers)">
                    <div>
                        <div class="group-title">@top</div>
                        <div class="muted tiny">@members.Sum(m => m.Lessons.Count(IsDone)) / @members.Sum(m => m.Lessons.Count)@(members.Sum(m => m.TotalSeconds) is > 0 and var secs ? $" · {Format.Long(secs)}" : "") · @L["{0} parts", members.Count]</div>
                    </div>
                    <span class="chev">⌄</span>
                </button>
            }
            <div class="section @(open ? "open" : "") @(grouped ? "nested" : "")">
                <button class="section-head" @onclick="() => ToggleSection(si)">
                    <div>
                        <div class="section-title">@(grouped ? RelativeTitle(section, top) : SectionTitle(section.FullTitle))</div>
                        <div class="muted tiny">@done / @section.Lessons.Count@(section.TotalSeconds > 0 ? $" · {Format.Long(section.TotalSeconds)}" : "")</div>
                    </div>
                    <span class="chev">⌄</span>
                </button>
                @if (open)
                {
                    <ul>
                        @foreach (var l in section.Lessons)
                        {
                            var p = progress.GetValueOrDefault(l.RelativePath);
                            var partial = p is { Completed: false, PositionSeconds: > 0, DurationSeconds: > 0 } ? p.PositionSeconds / p.DurationSeconds * 100 : 0;
                            var marks = notes.Count(n => n.LessonPath == l.RelativePath);
                            <li class="@(l.Id == lesson.Id ? "current" : "")" id="@($"l-{l.Id}")">
                                <button class="check @(IsDone(l) ? "on" : "")" title="@(IsDone(l) ? L["Mark as not complete"] : L["Mark as complete"])"
                                        @onclick="() => ToggleComplete(l)">@(IsDone(l) ? "✓" : "")</button>
                                <a href="@($"course/{course.Id}/{l.Id}")">
                                    <span class="l-title">@(lessons.IndexOf(l) + 1). @l.Title</span>
                                    <span class="l-meta muted tiny">
                                        @(l.Kind == LessonKind.Video ? "▶" : "📄") @(l.Kind == LessonKind.Video ? Format.Clock(l.DurationSeconds) : L["Reading"])
                                        @if (marks > 0) { <span title="@L["Notes and bookmarks"]"> · ✎ @marks</span> }
                                        @if (l.Attachments.Count > 0) { <span title="@L["Attachments"]"> · 📎 @l.Attachments.Count</span> }
                                    </span>
                                    @if (partial > 0)
                                    {
                                        <span class="l-bar"><span style="width:@(partial)%"></span></span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        }
        @if (CanSaveOffline)
        {
            <div class="curriculum-foot">
                <button class="btn ghost small" @onclick="SaveCourseOffline" disabled="@(courseOffline is not null)">
                    @(courseOffline is { } co ? L["Saving course… {0}", co] : "⬇ " + L["Save whole course offline"])
                </button>
            </div>
        }
    </aside>
</div>
}

@code {
    [Parameter] public string CourseId { get; set; } = "";
    [Parameter] public string? LessonId { get; set; }
    [SupplyParameterFromQuery(Name = "t")] public double? StartAt { get; set; }
    /// <summary>Set by explicit "play" links (Resume, a lesson in the outline). Without it the first video waits for a click.</summary>
    [SupplyParameterFromQuery(Name = "play")] public string? Play { get; set; }
    /// <summary>True once the viewer has moved to another lesson in this player (next, outline, up-next).</summary>
    private bool switchedLesson;

    private static readonly double[] Rates = [0.5, 0.75, 1, 1.25, 1.5, 1.75, 2];
    private static readonly string[] TabNames = ["Overview", "Notes", "Bookmarks", "Chapters", "Transcript", "Study", "Discussion", "Resources"];

    private Course? course;
    private Lesson? lesson;
    private List<Lesson> lessons = [];
    private int lessonIndex;
    private Lesson? prevLesson, nextLesson;
    private Dictionary<string, LessonProgress> progress = [];
    private CourseStats stats = new(0, 0, null, null);
    private CourseMeta meta = new();
    private List<Note> notes = [];
    private List<LearningPath> paths = [];
    private readonly HashSet<int> openSections = [];
    private bool sidebarOpen = true;
    private bool autoplay = true;
    private double playbackRate = 1;
    private int? countdown;
    private CancellationTokenSource? countdownCts;
    private string tab = "Overview";

    private ElementReference videoRef, viewerRef;
    private IJSObjectReference? module, offline;
    private DotNetObjectReference<CoursePage>? selfRef;
    private string? attachedKey;
    private string? transcriptAttachedFor;

    // playback
    private MediaInfo? media;
    private string? videoSrc;
    private PlaybackVariant? variant;
    private bool deciding;
    private string? playbackError;
    private string? decidedFor;
    private string AttachKey => $"{lesson?.Id}|{MediaSrc}";
    private PrepareJob? PrepJob => lesson is null || variant is null or PlaybackVariant.Direct ? null : Transcoder.JobFor(lesson, variant.Value);
    private IReadOnlyList<Chapter> Chapters => media?.Chapters ?? [];

    // audio mode, sleep timer, casting, kids' limit
    private bool audioMode;
    private double? resumeOverride;
    private int sleepChoice;
    private DateTime? sleepAt;
    private bool sleepAfterLesson;
    private CancellationTokenSource? sleepCts;
    private IJSObjectReference? cast;
    private bool castAvailable, casting;
    private string? castError;
    private double? kidRemaining;
    private bool timeUp;
    /// <summary>Downloads play without the server, so they'd skip a kid's daily limit and a guest link's expiry.</summary>
    private bool CanSaveOffline => !IsKid && !IsGuest;
    private string? AudioUrl => lesson is not null && Transcoder.PreparedFile(lesson, PlaybackVariant.Audio) is not null ? $"{lesson.MediaUrl}?v=audio" : null;
    /// <summary>Listening mode only switches once the audio file is ready; until then the video keeps playing.</summary>
    private bool AudioActive => audioMode && AudioUrl is not null && !timeUp;
    private string? MediaSrc => AudioActive ? AudioUrl : videoSrc;

    // household
    private List<CommentView> comments = [];
    private List<SharedNoteView> sharedNotes = [];
    private List<GuestLinkInfo> guestLinks = [];
    private string guestLabel = "";
    private int guestDays = 7;
    private string? newGuestUrl;

    // offline
    private bool offlineSaved;
    private int? offlineProgress;
    private string? courseOffline;

    private IEnumerable<double> RateOptions => Rates.Contains(playbackRate) ? Rates : Rates.Append(playbackRate).Order();
    private Section? CurrentSection => course?.Sections.FirstOrDefault(s => s.Lessons.Contains(lesson!));

    private int? TabCount(string t) => t switch
    {
        "Notes" => notes.Count(n => n.Kind == NoteKind.Note),
        "Bookmarks" => notes.Count(n => n.Kind == NoteKind.Bookmark),
        "Chapters" => Chapters.Count,
        "Resources" => course is null || lesson is null ? null : course.Resources.Count + lesson.Attachments.Count + (CurrentSection?.Files.Count ?? 0),
        "Discussion" => comments.Count,
        _ => null,
    };

    protected override void OnInitialized()
    {
        Library.Changed += OnLibraryChanged;
        Transcripts.Changed += OnServiceChanged;
        Transcoder.Changed += OnTranscoderChanged;
        Transcoder.Changed += OnAudioMaybeReady;
    }

    protected override async Task OnInitializedAsync() => aiEnabled = await Ai.IsEnabledAsync();

    private void OnLibraryChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    private void OnServiceChanged() => InvokeAsync(StateHasChanged);

    private void OnTranscoderChanged() => InvokeAsync(() =>
    {
        // A conversion we're waiting for finished: switch to it.
        if (lesson is not null && videoSrc is null && variant is { } v && v != PlaybackVariant.Direct && Transcoder.PreparedFile(lesson, v) is not null)
            videoSrc = $"{lesson.MediaUrl}?v={v.ToString().ToLowerInvariant()}";
        StateHasChanged();
    });

    private void OnAudioMaybeReady() => InvokeAsync(async () =>
    {
        // The listening-mode file just finished: continue from where the video is.
        if (audioMode && AudioUrl is not null && attachedKey != AttachKey && module is not null)
            resumeOverride = await module.InvokeAsync<double>("getTime");
        StateHasChanged();
    });

    protected override async Task OnParametersSetAsync()
    {
        await EnsureUserAsync();
        CancelCountdown();
        var previous = lesson?.Id;
        await LoadAsync();
        if (lesson is null || course is null) return;

        if (previous != lesson.Id)
        {
            CancelNote();
            ResetStudy();
            castError = null;
            comments = IsGuest ? [] : await Comments.ForLessonAsync(lesson);
            if (audioMode && lesson.Kind == LessonKind.Video) Transcoder.Enqueue(lesson, PlaybackVariant.Audio);
            media = null;
            videoSrc = null;
            variant = null;
            playbackError = null;
            offlineProgress = null;
            transcriptLanguage = null;
            var sectionIndex = course.Sections.ToList().FindIndex(s => s.Lessons.Contains(lesson));
            if (sectionIndex >= 0) openSections.Add(sectionIndex);
            if (tab == "Study") await LoadStudyAsync();
        }

        if (Me is { IsKid: true } kid)
        {
            kidRemaining = await WatchTime.RemainingAsync(kid);
            timeUp = kidRemaining is <= 0;
        }

        // Opening a reading lesson counts as "touched" so "Continue learning" finds it.
        if (lesson.Kind == LessonKind.Article && !progress.ContainsKey(lesson.RelativePath))
        {
            progress[lesson.RelativePath] = await ProgressService.SavePositionAsync(UserId, course, lesson, 0, 0);
        }
    }

    private async Task LoadAsync()
    {
        course = Library.GetCourse(CourseId);
        if (course is not null && !CourseLibrary.CanAccess(course, Access)) course = null;
        if (course is null) { lesson = null; return; }

        lessons = course.AllLessons.ToList();
        progress = await ProgressService.ForCourseAsync(UserId, course);
        stats = ProgressService.Stats(course, progress);
        meta = await UserData.MetaAsync(UserId, course);
        notes = await UserData.NotesForCourseAsync(UserId, course);
        paths = await UserData.PathsAsync(UserId);
        if (!IsGuest)
        {
            sharedNotes = await Comments.SharedNotesAsync(course, UserId);
            if (!IsKid) guestLinks = await Guests.ListAsync(UserId, IsAdmin, course.FolderName);
        }

        lesson = LessonId is null
            ? stats.ResumeLesson ?? lessons.FirstOrDefault()
            : lessons.FirstOrDefault(l => l.Id == LessonId);
        if (lesson is null) return;

        lessonIndex = lessons.IndexOf(lesson);
        prevLesson = lessonIndex > 0 ? lessons[lessonIndex - 1] : null;
        nextLesson = lessonIndex < lessons.Count - 1 ? lessons[lessonIndex + 1] : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./player.js");
            offline = await JS.InvokeAsync<IJSObjectReference>("import", "./offline.js");
            selfRef = DotNetObjectReference.Create(this);
            playbackRate = await module.InvokeAsync<double>("getSavedRate");
            autoplay = await module.InvokeAsync<bool>("getAutoplay");
            var savedTab = await module.InvokeAsync<string?>("getPref", "lyceum.tab", "Overview");
            tab = savedTab is not null && TabNames.Contains(savedTab) ? savedTab : "Overview";
            if (tab == "Study") await LoadStudyAsync();
            if (tab == "Discussion" && IsGuest) tab = "Overview";
            audioMode = await module.InvokeAsync<bool>("getPref", "lyceum.audio", false);
            if (audioMode && lesson?.Kind == LessonKind.Video) Transcoder.Enqueue(lesson, PlaybackVariant.Audio);
            await offline.InvokeVoidAsync("flushProgress");
            try
            {
                cast = await JS.InvokeAsync<IJSObjectReference>("import", "./cast.js");
                await cast.InvokeVoidAsync("init", selfRef);
            }
            catch (JSException) { /* casting is optional */ }
            StateHasChanged();
        }
        if (module is null || lesson is null) return;

        if (lesson.Kind == LessonKind.Video && decidedFor != lesson.Id && !deciding) await DecidePlaybackAsync();

        if (attachedKey != AttachKey)
        {
            var newLesson = attachedKey?.Split('|')[0] != lesson.Id;
            if (newLesson && attachedKey is not null) switchedLesson = true;
            attachedKey = AttachKey;
            if (newLesson) await module.InvokeVoidAsync("scrollLessonIntoView", $"l-{lesson.Id}");
            if (lesson.Kind == LessonKind.Video && MediaSrc is not null && !timeUp)
            {
                var p = progress.GetValueOrDefault(lesson.RelativePath);
                var resumeAt = resumeOverride ?? StartAt ?? (p is { Completed: false } ? p.PositionSeconds : 0);
                // Play straight away only when asked to: a play link, a lesson switch, or carrying on in listening mode.
                var play = switchedLesson || Play is not null || resumeOverride is not null;
                resumeOverride = null;
                await module.InvokeVoidAsync("attach", videoRef, viewerRef, selfRef, lesson.Id, resumeAt, playbackRate, meta.SkipIntroSeconds, new
                {
                    title = lesson.Title, course = course!.Title, artwork = new Uri(new Uri(Nav.BaseUri), course.CoverPath is not null ? course.CoverUrl : lesson.ThumbUrl).ToString(),
                    hasNext = nextLesson is not null, hasPrev = prevLesson is not null,
                    autoplay = play,
                });
                offlineSaved = offline is not null && await offline.InvokeAsync<bool>("isSaved", lesson.Id);
                StateHasChanged();
            }
            else
            {
                await module.InvokeVoidAsync("detach");
            }
        }

        // The transcript list is re-rendered per lesson/language; hook up highlighting and click-to-seek once per render of it.
        var key = tab == "Transcript" && Transcripts.GetCues(lesson, transcriptLanguage).Count > 0 ? $"{lesson.Id}|{transcriptLanguage}" : null;
        if (key != transcriptAttachedFor)
        {
            transcriptAttachedFor = key;
            if (key is not null) await module.InvokeVoidAsync("attachTranscript", "transcript");
        }
    }

    /// <summary>
    /// Asks the browser whether it can play the original file; if not, whether a lossless MP4 repackage would do;
    /// otherwise uses (or starts) an H.264 conversion.
    /// </summary>
    private async Task DecidePlaybackAsync()
    {
        deciding = true;
        try
        {
            var l = lesson!;
            media = await Probe.ProbeAsync(l.FullPath);
            var choice = media is null ? "direct" // no ffprobe: just try the file
                : await module!.InvokeAsync<string>("chooseSource", media.DirectMime, media.RemuxMime);
            if (lesson?.Id != l.Id) return; // navigated away meanwhile
            decidedFor = l.Id;
            variant = choice switch { "remux" => PlaybackVariant.Remux, "h264" => PlaybackVariant.H264, _ => PlaybackVariant.Direct };

            if (variant == PlaybackVariant.Direct) videoSrc = l.MediaUrl;
            else if (Transcoder.PreparedFile(l, variant.Value) is not null) videoSrc = $"{l.MediaUrl}?v={choice}";
            else if (Tools.Ffmpeg is null) playbackError = L["This video's format can't play in your browser, and ffmpeg isn't installed on the server to convert it."];
            else Transcoder.Enqueue(l, variant.Value);
            StateHasChanged();
        }
        finally
        {
            deciding = false;
        }
    }

    private void RetryPrepare()
    {
        if (lesson is null || variant is not { } v) return;
        Transcoder.ClearFinished();
        Transcoder.Enqueue(lesson, v);
    }

    private async Task SetTab(string t)
    {
        tab = t;
        if (t == "Study") await LoadStudyAsync();
        if (module is not null) await module.InvokeVoidAsync("setPref", "lyceum.tab", t);
    }

    private async Task Seek(double seconds)
    {
        if (module is not null) await module.InvokeVoidAsync("seek", seconds);
    }

