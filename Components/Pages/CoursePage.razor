                            @(studyBusy == "summary" ? L["Writing…"] : summary is null ? L["Summarize this lesson"] : L["Regenerate"])
                        </button>
                    </div>
                    @if (summary is not null) { <div class="md">@Md.Render(summary)</div> }
                </section>

                <section class="panel">
                    <div class="study-head">
                        <h3>❓ @L["Quiz"]</h3>
                        <button class="btn ghost small" disabled="@(studyBusy is not null)" @onclick='() => RunStudy("quiz", regenerate: quiz is not null)'>
                            @(studyBusy == "quiz" ? L["Writing questions…"] : quiz is null ? L["Quiz me"] : L["New questions"])
                        </button>
                    </div>
                    @if (quiz is not null)
                    {
                        @foreach (var (q, qi) in quiz.Select((q, i) => (q, i)))
                        {
                            <div class="quiz-q">
                                <div class="quiz-question">@(qi + 1). @q.Question</div>
                                @foreach (var (opt, oi) in q.Options.Select((o, i) => (o, i)))
                                {
                                    var state = !quizChecked ? "" : oi == q.Answer ? "right" : quizAnswers.GetValueOrDefault(qi, -1) == oi ? "wrong" : "";
                                    <label class="quiz-option @state">
                                        <input type="radio" name="@($"q{qi}")" checked="@(quizAnswers.GetValueOrDefault(qi, -1) == oi)" disabled="@quizChecked"
                                               @onchange="() => quizAnswers[qi] = oi" /> @opt
                                    </label>
                                }
                                @if (quizChecked && !string.IsNullOrWhiteSpace(q.Explanation)) { <div class="muted tiny">@q.Explanation</div> }
                            </div>
                        }
                        <div class="row">
                            @if (!quizChecked)
                            {
                                <button class="btn primary small" disabled="@(quizAnswers.Count < quiz.Count)" @onclick="() => quizChecked = true">@L["Check answers"]</button>
                            }
                            else
                            {
                                <strong>@L["{0} of {1} correct", quiz.Select((q, i) => quizAnswers.GetValueOrDefault(i, -1) == q.Answer).Count(x => x), quiz.Count]</strong>
                                <button class="btn ghost small" @onclick="() => { quizAnswers = []; quizChecked = false; }">@L["Try again"]</button>
                            }
                        </div>
                    }
                </section>

                <section class="panel">
                    <div class="study-head">
                        <h3>🃏 @L["Flashcards"]</h3>
                        @if (cards is not null && !IsGuest) { <button class="btn ghost small" @onclick="AddCardsToDeck">➕ @L["Add to my review deck"]</button> }
                        @if (cards is not null) { <a class="btn ghost small" href="@($"api/flashcards/{lesson.Id}.txt")" download>@L["Export for Anki"]</a> }
                        <button class="btn ghost small" disabled="@(studyBusy is not null)" @onclick='() => RunStudy("flashcards", regenerate: cards is not null)'>
                            @(studyBusy == "flashcards" ? L["Making cards…"] : cards is null ? L["Make flashcards"] : L["New cards"])
                        </button>
                    </div>
                    @if (cards is not null)
                    {
                        <div class="cards">
                            @foreach (var (c, ci) in cards.Select((c, i) => (c, i)))
                            {
                                <button class="flashcard @(flipped.Contains(ci) ? "flipped" : "")" @onclick="() => { if (!flipped.Remove(ci)) flipped.Add(ci); }">
                                    <span class="front">@c.Front</span>
                                    <span class="back">@c.Back</span>
                                </button>
                            }
                        </div>
                        <p class="muted tiny">@L["Click a card to flip it."]</p>
                    }
                </section>
            }
        </div>
    };

    private async Task RunStudy(string kind, bool regenerate)
    {
        if (lesson is null) return;
        var target = lesson;
        studyBusy = kind;
        studyError = null;
        try
        {
            if (regenerate) await Ai.ForgetAsync(target, kind);
            switch (kind)
            {
                case "summary": summary = await Ai.SummaryAsync(target); break;
                case "quiz": quiz = await Ai.QuizAsync(target); quizAnswers = []; quizChecked = false; break;
                case "flashcards": cards = await Ai.FlashcardsAsync(target); flipped = []; break;
            }
        }
        catch (Exception ex)
        {
            studyError = ex.Message;
        }
        finally
        {
            studyBusy = null;
        }
    }

    private async Task Ask()
    {
        if (course is null || string.IsNullOrWhiteSpace(question)) return;
        var q = question.Trim();
        question = "";
        studyBusy = "ask";
        studyError = null;
        askCts?.Cancel();
        askCts = new CancellationTokenSource();
        try
        {
            sources = await Ai.RetrieveAsync(course, q);
            answer = "";
            var sb = new System.Text.StringBuilder();
            var last = DateTime.UtcNow;
            await foreach (var piece in Ai.AskAsync(course, q, sources, chatHistory, askCts.Token))
            {
                sb.Append(piece);
                if ((DateTime.UtcNow - last).TotalMilliseconds > 120)
                {
                    answer = sb.ToString();
                    last = DateTime.UtcNow;
                    StateHasChanged();
                }
            }
            answer = sb.ToString();
            chatHistory.Add(new ChatTurn("user", q));
            chatHistory.Add(new ChatTurn("assistant", answer));
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            studyError = ex.Message;
        }
        finally
        {
            studyBusy = null;
        }
    }

