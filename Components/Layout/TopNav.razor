@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<header class="topbar">
    <a class="brand" href="./"><span class="logo" aria-hidden="true"></span><span class="hide-mobile">Lyceum</span></a>
    <AuthorizeView>
        @if (context.User.IsGuest())
        {
            <span class="muted tiny">@L["Guest access"]</span>
        }
        else
        {
            <nav class="nav">
                @foreach (var (href, label) in Links)
                {
                    <a href="@(href == "/" ? "./" : href.TrimStart('/'))" class="@(IsActive(href) ? "active" : "")">@L[label]</a>
                }
                <a href="offline.html" target="_top" title="@L["Lessons saved on this device"]">@L["Downloads"]</a>
                @if (context.User.IsAdmin())
                {
                    <a href="admin" class="@(IsActive("/admin") ? "active" : "")">@L["Admin"]</a>
                }
            </nav>
        }
    </AuthorizeView>
    @ChildContent
    <button class="icon-btn theme-btn" title="@L["Theme: {0}", L[ThemeLabel]]" @onclick="CycleTheme"><Icon Name="@ThemeIcon" /></button>
    <AuthorizeView>
        @if (!context.User.IsGuest())
        {
            <a class="user-chip hide-mobile" href="settings" title="@L["Account settings"]">@context.User.Identity?.Name</a>
        }
    </AuthorizeView>
</header>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static readonly (string Href, string Label)[] Links =
    [
        ("/", "Home"), ("/courses", "My courses"), ("/review", "Review"), ("/paths", "Paths"), ("/notes", "Notes"), ("/stats", "Stats"), ("/settings", "Settings"),
    ];

    private string theme = "system";
    private string ThemeIcon => theme switch { "light" => "sun", "dark" => "moon", _ => "sun-moon" };
    private string ThemeLabel => theme switch { "light" => "Light", "dark" => "Dark", _ => "System" };

    private bool IsActive(string href)
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        if (href == "/courses" && path.StartsWith("/course/")) return true; // a course belongs under My courses
        return href == "/" ? path == "/" : path.StartsWith(href);
    }

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            theme = await JS.InvokeAsync<string>("lyceumTheme.get");
            StateHasChanged();
        }
        catch (JSException) { }
    }

    private async Task CycleTheme()
    {
        theme = theme switch { "system" => "light", "light" => "dark", _ => "system" };
        await JS.InvokeVoidAsync("lyceumTheme.set", theme);
    }

    private void OnLocationChanged(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
