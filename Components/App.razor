<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="@(AppPaths.Base + "/")" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <script>
        // Lyceum used to be called CourseHub: move saved settings (and queued offline progress) to the new names once.
        try { Object.keys(localStorage).forEach(k => { if (k.startsWith("coursehub.")) { const n = "lyceum." + k.slice(10); if (localStorage.getItem(n) === null) localStorage.setItem(n, localStorage.getItem(k)); localStorage.removeItem(k); } }); } catch {}
        // Apply the saved theme before first paint (no flash of the wrong theme).
        window.lyceumTheme = {
            get() { try { return localStorage.getItem("lyceum.theme") || "system"; } catch { return "system"; } },
            set(t) {
                try { t === "system" ? localStorage.removeItem("lyceum.theme") : localStorage.setItem("lyceum.theme", t); } catch {}
                if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; else delete document.documentElement.dataset.theme;
            },
        };
        lyceumTheme.set(lyceumTheme.get());
    </script>
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="icon" href="favicon.ico" sizes="32x32" />
    <link rel="icon" href="icon.svg" type="image/svg+xml" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <meta name="theme-color" content="#0f1115" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Lyceum" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="_framework/blazor.web.js"></script>
    <script>
        if ("serviceWorker" in navigator) navigator.serviceWorker.register("sw.js").catch(() => {});
    </script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Sign-in pages render on the server (they set the auth cookie); everything else is interactive.
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
